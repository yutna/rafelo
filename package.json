{
  "name": "rafelo",
  "private": true,
  "description": "An opinionated Rails 8.1 BFF template",
  "license": "MIT",
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": "26.13.0",
    "npm": "12.2.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "aliases:generate": "ruby script/ci/aliases",
    "aliases:check": "ruby script/ci/aliases --check",
    "arch:check": "depcruise --config .dependency-cruiser.cjs app engines",
    "graph:generate": "ruby script/ci/engine_graph",
    "graph:check": "ruby script/ci/engine_graph --check"
  },
  "dependencies": {
    "@inertiajs/react": "3.11.0",
    "@inertiajs/vite": "3.11.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vite-plugin-ruby": "5.2.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.0",
    "vitest": "5.1.0",
    "dependency-cruiser": "18.7.2"
  }
}
