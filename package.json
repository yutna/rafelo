{
  "name": "rafelo",
  "private": true,
  "description": "An opinionated Rails 8.1 BFF template",
  "license": "MIT",
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": "26.13.0",
    "npm": "12.2.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
