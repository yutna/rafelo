{
  "name": "acme",
  "private": true,
  "description": "An opinionated Rails 8.1 BFF template",
  "license": "MIT",
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": "26.13.0",
    "npm": "12.2.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "node script/ci/eslint/check_config.mjs && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "aliases:generate": "ruby script/ci/aliases",
    "aliases:check": "ruby script/ci/aliases --check",
    "arch:check": "depcruise --config .dependency-cruiser.cjs app engines e2e script",
    "graph:generate": "ruby script/ci/engine_graph",
    "graph:check": "ruby script/ci/engine_graph --check",
    "contracts:generate": "tsx --tsconfig tsconfig.tooling.json script/contracts/generate.mts",
    "contracts:check": "tsx --tsconfig tsconfig.tooling.json script/contracts/generate.mts --check",
    "errors:generate": "tsx --tsconfig tsconfig.tooling.json script/contracts/errors.mts",
    "errors:check": "tsx --tsconfig tsconfig.tooling.json script/contracts/errors.mts --check",
    "i18n:generate": "tsx --tsconfig tsconfig.tooling.json script/contracts/i18n.mts",
    "i18n:check": "tsx --tsconfig tsconfig.tooling.json script/contracts/i18n.mts --check",
    "docs:generate": "tsx --tsconfig tsconfig.tooling.json script/docs/generate.ts",
    "docs:check": "tsx --tsconfig tsconfig.tooling.json script/docs/generate.ts --check",
    "docs:canary": "tsx --tsconfig tsconfig.tooling.json script/docs/canary.ts",
    "pages:check": "ruby script/ci/page_props",
    "api:generate": "tsx --tsconfig tsconfig.tooling.json script/contracts/design_system_api.mts",
    "api:check": "tsx --tsconfig tsconfig.tooling.json script/contracts/design_system_api.mts --check",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "permissions:generate": "ruby script/contracts/permissions",
    "permissions:check": "ruby script/contracts/permissions --check"
  },
  "dependencies": {
    "@inertiajs/react": "3.11.0",
    "@inertiajs/vite": "3.11.0",
    "@tanstack/react-table": "8.21.3",
    "echarts": "6.1.0",
    "i18next": "27.1.1",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@babel/core": "7.29.13",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-perfectionist": "5.14.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "65.0.0",
    "globals": "17.14.0",
    "jscpd": "5.4.3",
    "jsdom": "31.0.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vite-plugin-ruby": "5.2.6",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
