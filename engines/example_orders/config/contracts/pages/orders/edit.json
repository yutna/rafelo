{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "auth": {
      "$ref": "https://rafelo.local/contracts/_shared.json#/properties/auth"
    },
    "trace": {
      "$ref": "https://rafelo.local/contracts/_shared.json#/properties/trace"
    },
    "app": {
      "$ref": "https://rafelo.local/contracts/_shared.json#/properties/app"
    },
    "nav": {
      "$ref": "https://rafelo.local/contracts/_shared.json#/properties/nav"
    },
    "errors": {
      "$ref": "https://rafelo.local/contracts/_shared.json#/properties/errors"
    },
    "data": {
      "type": "object",
      "properties": {
        "order": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "number": {
              "type": "string"
            },
            "customerName": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "number",
            "customerName",
            "status",
            "version"
          ],
          "additionalProperties": false
        },
        "updatePath": {
          "type": "string"
        },
        "showPath": {
          "type": "string"
        }
      },
      "required": [
        "order",
        "updatePath",
        "showPath"
      ],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "formToken": {
          "type": "string"
        }
      },
      "required": [
        "formToken"
      ],
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "pagination": {
      "type": "null"
    },
    "can": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  "required": [
    "auth",
    "trace",
    "app",
    "nav",
    "errors",
    "data",
    "meta",
    "query",
    "pagination",
    "can"
  ],
  "additionalProperties": false
}
