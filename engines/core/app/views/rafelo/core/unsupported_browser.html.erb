<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csp-nonce" content="<%= content_security_policy_nonce %>">
    <title><%= t("core.unsupported_browser.title") %></title>
    <style nonce="<%= content_security_policy_nonce %>">
      body { margin: 0; font-family: system-ui, sans-serif; background: #f8fafc; color: #0f172a; }
      main { max-width: 36rem; margin: 15vh auto; padding: 2rem; }
      h1 { font-size: 1.75rem; }
      p { line-height: 1.6; }
    </style>
  </head>
  <body>
    <main>
      <h1><%= t("core.unsupported_browser.title") %></h1>
      <p><%= t("core.unsupported_browser.body") %></p>
    </main>
  </body>
</html>
