#!/usr/bin/env ruby
# frozen_string_literal: true

engine = ARGV.fetch(0) { abort("usage: bin/check <engine>") }
abort("unknown engine: #{engine}") unless Dir.exist?(File.join("engines", engine))

def run!(command)
  puts "==> #{command}"
  system(command) || abort("command failed: #{command}")
end

run!("bin/packwerk check engines/#{engine}")
run!("npm run arch:check")
run!("npx tsc -b engines/#{engine}/tsconfig.json")

engine_vitest = File.join("engines", engine, "vitest.config.mts")
if File.exist?(engine_vitest)
  run!("npx vitest run --config #{engine_vitest}")
elsif system("npx vitest run --project #{engine} --project #{engine}:node")
  # ok
else
  run!("npm test")
end

if Dir.exist?(File.join("engines", engine, "spec"))
  run!("bundle exec rspec engines/#{engine}/spec")
end

run!("node script/ci/eslint/check_config.mjs")
run!("npx eslint --cache --cache-location tmp/cache/eslint/#{engine}/ --max-warnings 0 engines/#{engine}")
run!("npx prettier --check --cache engines/#{engine}")

puts "bin/check #{engine}: ok"
