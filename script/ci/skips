#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"

root = Dir.pwd
OptionParser.new do |parser|
  parser.banner = "Usage: script/ci/skips [--root DIR]"
  parser.on("--root DIR") { |value| root = value }
end.parse!

root = File.expand_path(root)
abort "skips: root does not exist: #{root}" unless Dir.exist?(root)

SKIP_FORMS = [
  /(?<![\w.:])skip(?![\w:])/,
  /\b(?:xit|xspecify|xexample|xdescribe|xcontext)\b/,
  /\.skip\b/,
  /\bpending(?!\s*:)\b/,
  /\b(?:skip|pending):/,
  /\b(?:it|specify|example|describe|context|feature|scenario)\b.*(?<![\w:]):skip\b/,
  /\bprosopite:\s*false\b/,
  /\bProsopite\.pause\b/,
  /\b(?:it|test|describe)\.(?:todo|skipIf|fixme)\b/,
  /\btest\.describe\.(?:skip|fixme)\b/
].freeze

ISSUE_REFERENCE = /(?:#\d+|https:\/\/github\.com\/[^\/\s]+\/[^\/\s]+\/issues\/\d+)/

patterns = [
  "spec/**/*",
  "app/frontend/**/*.test.ts",
  "app/frontend/**/*.test.tsx",
  "e2e/**/*.ts",
  "engines/*/spec/**/*",
  "engines/*/app/frontend/**/*.test.ts",
  "engines/*/app/frontend/**/*.test.tsx",
  "engines/*/e2e/**/*.ts"
]
files = patterns.flat_map { |pattern| Dir[File.join(root, pattern)] }.uniq.select { |path| File.file?(path) }
abort "skips: no test files found under #{root}" if files.empty?

findings = 0
files.each do |path|
  relative = path.delete_prefix("#{root}/")
  next if relative.start_with?("spec/enforcement/fixtures/")
  # A test-only engine keeps application code under spec/; its controller
  # callbacks are not skipped tests.
  next if relative.match?(%r{\Aengines/[^/]+/spec/[^/]+/app/})

  File.readlines(path, chomp: true).each_with_index do |line, index|
    # Strip string literals before both the code and the comment checks: a
    # "#123" inside a description is not an issue reference (TS-04).
    without_strings = line.gsub(/(["']).*?\1/, '""')
    comment = without_strings[/\s+(#.*)\z/, 1]
    code = without_strings.sub(/\s+#.*\z/, "")
    next if code.lstrip.start_with?("#")

    next unless SKIP_FORMS.any? { |form| code.match?(form) }

    next if comment&.match?(ISSUE_REFERENCE)
    next if relative.start_with?("spec/enforcement/") && code.match?(/prosopite:\s*false|Prosopite\.pause/)

    puts "#{relative}:#{index + 1}: skip-needs-issue: add #<number> or an issue URL on the same line"
    findings += 1
  end
end

warn "skips: checked #{files.length} files; findings=#{findings}"
exit(findings.zero? ? 0 : 1)
