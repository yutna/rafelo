#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"
require "open3"
require "tmpdir"

root = File.expand_path("../..", __dir__)
script = File.join(root, "script", "ci", "guard_approval")
failures = 0
cases = 0

def git(dir, *args)
  output, error, status = Open3.capture3("git", "-C", dir, *args)
  abort "guard_approval_canary: git #{args.join(' ')} failed: #{error}" unless status.success?

  output
end

def reviews(dir, name, entries)
  path = File.join(dir, "#{name}.json")
  File.write(path, JSON.generate(entries))
  path
end

def run_case(script, dir, base, reviews_file, event = "pull_request", author = nil, env = {})
  args = [ script, "--root", dir, "--base", base, "--event", event ]
  args += [ "--reviews", reviews_file ] if reviews_file
  args += [ "--author", author ] if author
  output, status = Open3.capture2e(env, *args)
  [ status.exitstatus, output ]
end

# A git wrapper that counts the "show" calls made by the script under test, so
# a canary can prove CODEOWNERS is loaded once for a whole diff (WF-03).
def git_shim(dir)
  bin = File.join(dir, "bin")
  FileUtils.mkdir_p(bin)
  real_git = ENV.fetch("PATH", "").split(File::PATH_SEPARATOR)
    .map { |entry| File.join(entry, "git") }
    .find { |path| File.executable?(path) }
  abort "guard_approval_canary: git is not on PATH" if real_git.nil?

  File.write(File.join(bin, "git"), <<~BASH)
    #!/usr/bin/env bash
    for arg in "$@"; do
      if [ "$arg" = "show" ]; then printf '%s\\n' "$*" >> "$GIT_SHOW_CALLS"; fi
    done
    exec #{real_git} "$@"
  BASH
  File.chmod(0o755, File.join(bin, "git"))
  { "PATH" => "#{bin}:#{ENV.fetch("PATH", "")}" }
end

Dir.mktmpdir("rafelo-guard-canary-") do |dir|
  git(dir, "init", "-q")
  git(dir, "config", "user.email", "canary@rafelo.invalid")
  git(dir, "config", "user.name", "Canary")
  FileUtils.mkdir_p(File.join(dir, ".github"))
  FileUtils.mkdir_p(File.join(dir, "script", "ci"))
  FileUtils.mkdir_p(File.join(dir, "config"))
  FileUtils.mkdir_p(File.join(dir, "spec", "enforcement", "fixtures"))
  File.write(File.join(dir, ".github", "CODEOWNERS"),
             "/script/ci/ @owner\n/engines/core/app/ @owner\n/spec/enforcement/ @owner\n/.github/CODEOWNERS @owner\n")
  File.write(File.join(dir, "script", "ci", "guard"), "one\n")
  File.write(File.join(dir, "config", "ratchets.yml"), "skipped_tests: 0\n")
  File.write(File.join(dir, "spec", "enforcement", "fixtures", "guard"), "one\n")
  File.write(File.join(dir, "README.md"), "base\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "base")
  base = git(dir, "rev-parse", "HEAD").strip

  File.write(File.join(dir, "script", "ci", "guard"), "two\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "guard")

  owner = reviews(dir, "owner", [ { "user" => { "login" => "owner" }, "state" => "APPROVED" } ])
  outsider = reviews(dir, "outsider", [ { "user" => { "login" => "someone" }, "state" => "APPROVED" } ])
  rejected = reviews(dir, "rejected", [
    { "user" => { "login" => "owner" }, "state" => "APPROVED" },
    { "user" => { "login" => "owner" }, "state" => "CHANGES_REQUESTED" }
  ])

  [
    [ "guard without approval", nil, 1, "pull_request", "outsider" ],
    [ "guard with an owner approval", owner, 0, "pull_request", "outsider" ],
    [ "guard with a non-owner approval", outsider, 1, "pull_request", "outsider" ],
    [ "guard with a later change request", rejected, 1, "pull_request", "outsider" ],
    [ "merge queue", nil, 0, "merge_group" ],
    [ "single-owner author", nil, 1, "pull_request", "owner" ],
    [ "author-only approval", owner, 1, "pull_request", "owner" ],
    [ "empty author fails closed", owner, 1, "pull_request", "" ]
  ].each do |name, file, expected, event, author|
    cases += 1
    status, output = run_case(script, dir, base, file, event || "pull_request", author)
    next if status == expected

    failures += 1
    warn "guard_approval_canary: #{name}: exited #{status}, expected #{expected}: #{output}"
  end

  # A second owner can approve a change the author cannot approve.
  File.write(File.join(dir, ".github", "CODEOWNERS"),
             "/script/ci/ @owner @second\n/engines/core/app/ @owner @second\n/spec/enforcement/ @owner @second\n/.github/CODEOWNERS @owner @second\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "second owner")
  File.write(File.join(dir, "script", "ci", "guard"), "three\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "guard again")
  cases += 1
  status, output = run_case(script, dir, "HEAD~1", nil, "pull_request", "owner")
  if status != 1
    failures += 1
    warn "guard_approval_canary: two owners still needs an approval: exited #{status}: #{output}"
  end

  second = reviews(dir, "second", [ { "user" => { "login" => "second" }, "state" => "APPROVED" } ])
  cases += 1
  status, output = run_case(script, dir, "HEAD~1", second, "pull_request", "owner")
  if status != 0
    failures += 1
    warn "guard_approval_canary: another owner approval: exited #{status}: #{output}"
  end

  cases += 1
  status, output = run_case(script, dir, "HEAD~1", owner, "pull_request", "owner")
  if status != 1
    failures += 1
    warn "guard_approval_canary: author-only approval: exited #{status}: #{output}"
  end

  # A renamed guard file is still a guard: the old path is in the diff, and
  # the approval decision follows the rename.
  FileUtils.mkdir_p(File.join(dir, "docs"))
  git(dir, "mv", "script/ci/guard", "docs/guard")
  git(dir, "commit", "-q", "-m", "rename the guard")
  cases += 1
  status, output = run_case(script, dir, "HEAD~1", nil)
  if status != 1
    failures += 1
    warn "guard_approval_canary: renamed guard: exited #{status}: #{output}"
  end

  cases += 1
  status, output = run_case(script, dir, "HEAD~1", owner, "pull_request", "owner")
  if status != 1
    failures += 1
    warn "guard_approval_canary: renamed guard with the author's approval: exited #{status}: #{output}"
  end

  cases += 1
  status, output = run_case(script, dir, "HEAD~1", second, "pull_request", "outsider")
  if status != 0
    failures += 1
    warn "guard_approval_canary: renamed guard with another owner's approval: exited #{status}: #{output}"
  end

  # Renaming CODEOWNERS itself is a guard change.
  git(dir, "mv", ".github/CODEOWNERS", ".github/CODEOWNERS.backup")
  git(dir, "commit", "-q", "-m", "rename CODEOWNERS")
  cases += 1
  status, output = run_case(script, dir, "HEAD~1", nil, "pull_request", "outsider")
  if status != 1
    failures += 1
    warn "guard_approval_canary: renamed CODEOWNERS: exited #{status}: #{output}"
  end

  cases += 1
  status, output = run_case(script, dir, "HEAD~1", second, "pull_request", "outsider")
  if status != 0
    failures += 1
    warn "guard_approval_canary: renamed CODEOWNERS with another owner's approval: exited #{status}: #{output}"
  end

  git(dir, "mv", ".github/CODEOWNERS.backup", ".github/CODEOWNERS")
  git(dir, "commit", "-q", "-m", "restore CODEOWNERS")

  # Removing a guard path from CODEOWNERS in the pull request does not remove
  # the guard: the owners are read from the merge base.
  base_before_removal = git(dir, "rev-parse", "HEAD").strip
  File.write(File.join(dir, ".github", "CODEOWNERS"),
             "/engines/core/app/ @owner @second\n/spec/enforcement/ @owner @second\n")
  File.write(File.join(dir, "script", "ci", "guard"), "four\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "remove the guard path")
  cases += 1
  status, output = run_case(script, dir, base_before_removal, nil, "pull_request", "outsider")
  if status != 1
    failures += 1
    warn "guard_approval_canary: CODEOWNERS removal: exited #{status}: #{output}"
  end

  # A ratchet file changed is not a guard.
  File.write(File.join(dir, "config", "ratchets.yml"), "skipped_tests: 1\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "ratchet")
  cases += 1
  status, output = run_case(script, dir, "HEAD~1", nil)
  if status != 0
    failures += 1
    warn "guard_approval_canary: ratchet file: exited #{status}: #{output}"
  end

  # A non-guard file changed passes.
  File.write(File.join(dir, "README.md"), "changed\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "readme")
  cases += 1
  status, output = run_case(script, dir, "HEAD~1", nil)
  if status != 0
    failures += 1
    warn "guard_approval_canary: non-guard file: exited #{status}: #{output}"
  end

  # A canary fixture is a guard file.
  File.write(File.join(dir, "spec", "enforcement", "fixtures", "guard"), "two\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "fixture")
  cases += 1
  status, output = run_case(script, dir, "HEAD~1", nil)
  if status != 1
    failures += 1
    warn "guard_approval_canary: canary fixture: exited #{status}: #{output}"
  end

  # GitHub matches a pattern without a slash at any depth: *.rb guards a file
  # in a nested directory, and it still leaves a non-.rb file unguarded.
  File.write(File.join(dir, ".github", "CODEOWNERS"), "*.rb @owner\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "extension pattern")
  FileUtils.mkdir_p(File.join(dir, "nested", "deep"))
  File.write(File.join(dir, "nested", "deep", "file.rb"), "one\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "nested ruby")
  cases += 1
  status, output = run_case(script, dir, "HEAD~1", nil)
  if status != 1
    failures += 1
    warn "guard_approval_canary: nested *.rb pattern: exited #{status}: #{output}"
  end

  File.write(File.join(dir, "nested", "deep", "file.txt"), "one\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "nested text")
  cases += 1
  status, output = run_case(script, dir, "HEAD~1", nil)
  if status != 0
    failures += 1
    warn "guard_approval_canary: *.rb leaves a nested .txt unguarded: exited #{status}: #{output}"
  end

  # A lone * matches a whole path, nested directories included.
  File.write(File.join(dir, ".github", "CODEOWNERS"), "* @owner\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "every path")
  FileUtils.mkdir_p(File.join(dir, "nested", "deeper"))
  File.write(File.join(dir, "nested", "deeper", "plain.txt"), "one\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "nested plain")
  cases += 1
  status, output = run_case(script, dir, "HEAD~1", nil)
  if status != 1
    failures += 1
    warn "guard_approval_canary: nested * pattern: exited #{status}: #{output}"
  end

  # A path git would quote (non-ASCII, spaces, quotes) is still a guard: the
  # diff is read NUL-separated and never parsed as display text (WF-03).
  File.write(File.join(dir, ".github", "CODEOWNERS"), "/script/ci/ @owner\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "guarded script directory")
  base_quoted = git(dir, "rev-parse", "HEAD").strip
  File.write(File.join(dir, "script", "ci", "évil.rb"), "one\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "non-ascii guard")
  cases += 1
  status, output = run_case(script, dir, base_quoted, nil, "pull_request", "outsider")
  if status != 1
    failures += 1
    warn "guard_approval_canary: non-ASCII guard path: exited #{status}: #{output}"
  end

  cases += 1
  status, output = run_case(script, dir, base_quoted, owner, "pull_request", "outsider")
  if status != 0
    failures += 1
    warn "guard_approval_canary: non-ASCII guard path with an owner approval: exited #{status}: #{output}"
  end

  FileUtils.mkdir_p(File.join(dir, "script", "ci", "dir with space"))
  File.write(File.join(dir, "script", "ci", "dir with space", "guard file.rb"), "one\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "spaced guard")
  cases += 1
  status, output = run_case(script, dir, "HEAD~1", nil, "pull_request", "outsider")
  if status != 1
    failures += 1
    warn "guard_approval_canary: spaced guard path: exited #{status}: #{output}"
  end

  File.write(File.join(dir, "script", "ci", "quo\"te.rb"), "one\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "quoted guard")
  cases += 1
  status, output = run_case(script, dir, "HEAD~1", nil, "pull_request", "outsider")
  if status != 1
    failures += 1
    warn "guard_approval_canary: quoted guard path: exited #{status}: #{output}"
  end

  # Restore the every-path pattern for the load-count case below.
  File.write(File.join(dir, ".github", "CODEOWNERS"), "* @owner\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "restore the every-path pattern")

  # A diff of many guard files loads the merge-base CODEOWNERS once, not once
  # per changed path.
  FileUtils.mkdir_p(File.join(dir, "many"))
  20.times { |index| File.write(File.join(dir, "many", "guard_#{index}.txt"), "one\n") }
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "many guards")
  show_calls = File.join(dir, "git-show-calls")
  FileUtils.rm_f(show_calls)
  cases += 1
  status, output = run_case(script, dir, "HEAD~1", nil, "pull_request", "outsider",
                            git_shim(dir).merge("GIT_SHOW_CALLS" => show_calls))
  shows = File.exist?(show_calls) ? File.readlines(show_calls, chomp: true).size : 0
  if status != 1
    failures += 1
    warn "guard_approval_canary: many guard files: exited #{status}: #{output}"
  end
  if shows != 1
    failures += 1
    warn "guard_approval_canary: many guard files loaded CODEOWNERS #{shows} times, expected 1"
  end
end

# The pull request workflow runs the merge base's checker and CODEOWNERS, not
# the pull request's copies (WF-03). An adopted app keeps it at .github/; this
# repository keeps the payload copy under template/.
workflow = [
  File.join(root, ".github", "workflows", "pull_request.yml"),
  File.join(root, "template", ".github", "workflows", "pull_request.yml")
].find { |path| File.file?(path) }
cases += 1
if workflow
  text = File.read(workflow)
  required = [
    'git show "$BASE_SHA:script/ci/guard_approval"',
    'git show "$BASE_SHA:script/ci/approvals.rb"',
    'ruby "$lib/guard_approval" --root "$PWD" --base "$BASE_SHA"'
  ]
  missing = required.reject { |line| text.include?(line) }
  unless missing.empty?
    failures += 1
    warn "guard_approval_canary: the workflow does not run the merge-base checker: #{missing.join(", ")}"
  end
else
  failures += 1
  warn "guard_approval_canary: the pull request workflow is missing"
end

if failures.positive?
  warn "guard_approval_canary: checked #{cases} cases; failures=#{failures}"
  exit 1
end

warn "guard_approval_canary: checked #{cases} cases; failures=0"
