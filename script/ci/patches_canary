#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/config/initializers/patches" "$tmp/spec/patches"
echo 'prepend Module' > "$tmp/config/initializers/patches/example.rb"

if "$root/script/ci/patches" --root "$tmp" >/dev/null 2>&1; then
  echo "patches_canary: a patch without specs passed" >&2
  exit 1
fi

mkdir -p "$tmp/engines/example/app/models" "$tmp/config/initializers"
echo 'String.class_eval { }' > "$tmp/engines/example/app/models/patch.rb"
if "$root/script/ci/patches" --root "$tmp" >/dev/null 2>&1; then
  echo "patches_canary: an engine patch outside the folder passed" >&2
  exit 1
fi
rm -f "$tmp/engines/example/app/models/patch.rb"
echo 'String.class_eval { }' > "$tmp/config/initializers/evil.rb"
if "$root/script/ci/patches" --root "$tmp" >/dev/null 2>&1; then
  echo "patches_canary: a config-initializer patch outside the folder passed" >&2
  exit 1
fi

empty="$(mktemp -d)"
trap 'rm -rf "$tmp" "$empty"' EXIT
mkdir -p "$empty/config/initializers/patches"
if "$root/script/ci/patches" --root "$empty" >/dev/null 2>&1; then
  echo "patches_canary: an empty patch directory passed" >&2
  exit 1
fi

legal="$(mktemp -d)"
trap 'rm -rf "$tmp" "$empty" "$legal"' EXIT
mkdir -p "$legal/config/initializers/patches" "$legal/spec/patches"
cat > "$legal/config/initializers/patches/legal.rb" <<'RUBY'
# why: upstream bug
# https://github.com/example/example/issues/1
Module.prepend(Module)
RUBY
cat > "$legal/spec/patches/legal_spec.rb" <<'RUBY'
RSpec.describe "legal" do
end
RUBY
cat > "$legal/spec/patches/legal_version_spec.rb" <<'RUBY'
RSpec.describe "legal version" do
  it { expect(Gem.loaded_specs).to be_a(Hash) }
end
RUBY
if ! "$root/script/ci/patches" --root "$legal" >/dev/null 2>&1; then
  echo "patches_canary: the legal patch failed" >&2
  exit 1
fi

echo "patches_canary: checked 5 cases"
