#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"

event = ENV["EVENT"].to_s
title = ENV["TITLE"].to_s

OptionParser.new do |parser|
  parser.banner = "Usage: script/ci/title [--event EVENT] [--title TITLE]"
  parser.on("--event EVENT") { |value| event = value }
  parser.on("--title TITLE") { |value| title = value }
end.parse!

if event == "merge_group"
  puts "title: linted on the pull request"
  exit 0
end

pattern = /\A(feat|fix|docs|chore|refactor|test|ci|build|perf|style|revert)(\([a-z0-9._\/-]+\))?(!)?: [^[:space:]].*\z/
if title.match?(pattern)
  puts "title: checked 1 title"
  exit 0
end

warn "title: the pull request title is not a Conventional Commit: #{pattern.source}"
warn "title: got #{title.inspect}"
exit 1
