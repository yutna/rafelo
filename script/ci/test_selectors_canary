#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "open3"
require "tmpdir"

root = File.expand_path("../..", __dir__)
script = File.join(root, "script", "ci", "test_selectors")

cases = [
  [ "engine vitest text selector", "engines/sample/app/frontend/thing.test.tsx",
    "expect(screen.getByText('can't be blank')).toBeInTheDocument();\n", 1 ],
  [ "engine vitest test id", "engines/sample/app/frontend/thing.test.tsx",
    "expect(screen.getByTestId('sample.thing.error')).toHaveTextContent('can't be blank');\n", 0 ],
  [ "engine e2e locator", "engines/sample/e2e/thing.spec.ts",
    "page.locator('.error');\n", 1 ],
  [ "engine e2e role", "engines/sample/e2e/thing.spec.ts",
    "page.getByRole('alert', { name: 'Error' });\n", 0 ],
  [ "role query without a name", "engines/sample/app/frontend/thing.test.tsx",
    "screen.getByRole('button');\n", 1 ],
  [ "role query with a name", "engines/sample/app/frontend/thing.test.tsx",
    "screen.getByRole('button', { name: 'Save' });\n", 0 ],
  [ "role query with a name on another line", "engines/sample/app/frontend/thing.test.tsx",
    "screen.getByRole('button', {\n  name: 'Save',\n});\n", 0 ],
  [ "role query with a shorthand name", "engines/sample/app/frontend/thing.test.tsx",
    "screen.getByRole('button', { name });\n", 0 ],
  [ "name text inside a string is not a name", "engines/sample/app/frontend/thing.test.tsx",
    "screen.getByRole('button', { description: 'name: optional' });\n", 1 ],
  [ "unbalanced parenthesis in a string", "engines/sample/app/frontend/thing.test.tsx",
    "screen.getByRole('button', { description: '(' });\nscreen.getByRole('checkbox', { name: 'x' });\n", 1 ],
  [ "shorthand name with an inline comment", "engines/sample/app/frontend/thing.test.tsx",
    "screen.getByRole('button', { name /* the label */ });\n", 0 ],
  [ "quoted name key is not a name", "engines/sample/app/frontend/thing.test.tsx",
    "screen.getByRole('button', { \"name\": 'x' });\n", 1 ],
  [ "role query inside a comment", "engines/sample/app/frontend/thing.test.tsx",
    "// screen.getByRole('button');\n", 0 ],
  [ "role query with an options variable", "engines/sample/app/frontend/thing.test.tsx",
    "screen.getByRole('button', options);\n", 1 ]
]

failures = 0
cases.each do |name, path, contents, expected|
  Dir.mktmpdir("rafelo-selectors") do |tmp|
    FileUtils.mkdir_p(File.dirname(File.join(tmp, path)))
    FileUtils.mkdir_p(File.join(tmp, "app", "frontend"))
    File.write(File.join(tmp, "app", "frontend", "ok.test.tsx"),
               "expect(screen.getByTestId('ok')).toBeInTheDocument();\n")
    File.write(File.join(tmp, path), contents)

    output, status = Open3.capture2e(script, "--root", tmp)
    next if status.exitstatus == expected &&
            (expected.zero? || (output.include?("bad-selector") && output.include?(path)))

    failures += 1
    warn "test_selectors_canary: #{name} exited #{status.exitstatus}, expected #{expected}"
    warn output
  end
end

# A missing root is a configuration error, not a crash.
missing = File.join(Dir.tmpdir, "rafelo-test_selectors-missing-#{Process.pid}")
output, status = Open3.capture2e(script, "--root", missing)
cases.append([ "missing root", "no root", "", 1 ])
unless status.exitstatus == 1 && output.include?("root does not exist")
  failures += 1
  warn "test_selectors_canary: missing root exited #{status.exitstatus}, expected 1"
  warn output
end

# An empty root fails closed instead of passing with nothing to check.
Dir.mktmpdir("rafelo-selectors-empty-") do |tmp|
  output, status = Open3.capture2e(script, "--root", tmp)
  cases.append([ "empty root", "no test files", "", 1 ])
  unless status.exitstatus == 1 && output.include?("no test files found")
    failures += 1
    warn "test_selectors_canary: empty root exited #{status.exitstatus}, expected 1"
    warn output
  end
end

if failures.positive?
  warn "test_selectors_canary: checked #{cases.length} cases; failures=#{failures}"
  exit 1
end

warn "test_selectors_canary: checked #{cases.length} cases; failures=0"
