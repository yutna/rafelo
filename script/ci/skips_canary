#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "open3"
require "tmpdir"

root = File.expand_path("../..", __dir__)
script = File.join(root, "script", "ci", "skips")

cases = [
  # [name, path, contents, expected exit]
  [ "engine spec skip without issue", "engines/sample/spec/thing_spec.rb",
    "it 'works' do\n  skip\nend\n", 1 ],
  [ "engine spec skip with issue", "engines/sample/spec/thing_spec.rb",
    "it 'works' do\n  skip #123\nend\n", 0 ],
  [ "engine vitest skip", "engines/sample/app/frontend/thing.test.tsx",
    "it.skip('renders', () => {});\n", 1 ],
  [ "engine e2e skip", "engines/sample/e2e/thing.spec.ts",
    "test.describe.skip('flow', () => {});\n", 1 ],
  [ "ruby bare skip", "engines/sample/spec/thing_spec.rb",
    "it 'works' do\n  skip\nend\n", 1 ],
  [ "ruby xdescribe", "engines/sample/spec/thing_spec.rb",
    "xdescribe 'flow' do\nend\n", 1 ],
  [ "ruby group skip metadata", "engines/sample/spec/thing_spec.rb",
    "describe 'works', :skip do\nend\n", 1 ],
  [ "ruby example skip metadata", "engines/sample/spec/thing_spec.rb",
    "it 'works', :skip do\nend\n", 1 ],
  [ "ruby example skip metadata with issue", "engines/sample/spec/thing_spec.rb",
    "it 'works', :skip do #123\nend\n", 0 ],
  [ "ruby group skip with issue", "engines/sample/spec/thing_spec.rb",
    "describe 'works', :skip do #123\nend\n", 0 ],
  [ "issue reference inside a string is not a reference", "engines/sample/spec/thing_spec.rb",
    "it 'works #123', :skip do\nend\n", 1 ],
  [ "ruby context skip metadata", "engines/sample/spec/thing_spec.rb",
    "context 'works', :skip do\nend\n", 1 ],
  [ "ruby pending metadata", "engines/sample/spec/thing_spec.rb",
    "it 'works', pending: true do\nend\n", 1 ],
  [ "ruby prosopite pause", "engines/sample/spec/thing_spec.rb",
    "Prosopite.pause\n", 1 ],
  [ "javascript xit", "engines/sample/app/frontend/thing.test.tsx",
    "xit('renders', () => {});\n", 1 ],
  [ "javascript todo", "engines/sample/app/frontend/thing.test.tsx",
    "it.todo('renders');\n", 1 ],
  [ "ruby xspecify", "engines/sample/spec/thing_spec.rb",
    "xspecify 'works' do\nend\n", 1 ],
  [ "ruby xexample", "engines/sample/spec/thing_spec.rb",
    "xexample 'works' do\nend\n", 1 ],
  [ "ruby xcontext", "engines/sample/spec/thing_spec.rb",
    "xcontext 'works' do\nend\n", 1 ],
  [ "ruby skip metadata", "engines/sample/spec/thing_spec.rb",
    "it 'works', skip: true do\nend\n", 1 ],
  [ "ruby plain pending", "engines/sample/spec/thing_spec.rb",
    "pending\n", 1 ],
  [ "ruby prosopite metadata", "engines/sample/spec/thing_spec.rb",
    "it 'works', prosopite: false do\nend\n", 1 ],
  [ "javascript skipIf", "engines/sample/app/frontend/thing.test.tsx",
    "it.skipIf(true)('renders', () => {});\n", 1 ],
  [ "javascript describe fixme", "engines/sample/e2e/thing.spec.ts",
    "test.describe.fixme('flow', () => {});\n", 1 ]
]

failures = 0
cases.each do |name, path, contents, expected|
  Dir.mktmpdir("rafelo-skips") do |tmp|
    FileUtils.mkdir_p(File.dirname(File.join(tmp, path)))
    FileUtils.mkdir_p(File.join(tmp, "spec"))
    File.write(File.join(tmp, "spec", "ok_spec.rb"), "it 'is clean' do\n  expect(1).to eq(1)\nend\n")
    File.write(File.join(tmp, path), contents)

    output, status = Open3.capture2e(script, "--root", tmp)
    next if status.exitstatus == expected &&
            (expected.zero? || (output.include?("skip-needs-issue") && output.include?(path)))

    failures += 1
    warn "skips_canary: #{name} exited #{status.exitstatus}, expected #{expected}"
    warn output
  end
end

# A missing root is a configuration error, not a crash.
missing = File.join(Dir.tmpdir, "rafelo-skips-missing-#{Process.pid}")
output, status = Open3.capture2e(script, "--root", missing)
cases.append([ "missing root", "no root", "", 1 ])
unless status.exitstatus == 1 && output.include?("root does not exist")
  failures += 1
  warn "skips_canary: missing root exited #{status.exitstatus}, expected 1"
  warn output
end

# An empty root fails closed instead of passing with nothing to check.
Dir.mktmpdir("rafelo-skips-empty-") do |tmp|
  output, status = Open3.capture2e(script, "--root", tmp)
  cases.append([ "empty root", "no test files", "", 1 ])
  unless status.exitstatus == 1 && output.include?("no test files found")
    failures += 1
    warn "skips_canary: empty root exited #{status.exitstatus}, expected 1"
    warn output
  end
end

if failures.positive?
  warn "skips_canary: checked #{cases.length} cases; failures=#{failures}"
  exit 1
end

warn "skips_canary: checked #{cases.length} cases; failures=0"
