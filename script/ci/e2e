#!/usr/bin/env bash
set -euo pipefail

port="${E2E_PORT:-3100}"
log="$(mktemp)"
rm -f tmp/pids/server.pid
RAILS_ENV=test bin/vite build >/tmp/rafelo-e2e-vite-build.log 2>&1
export E2E_SESSION_COOKIE="$(RAILS_ENV=test bin/rails runner 'viewer = Struct.new(:id, :name).new(7, "Ada"); _, token = Rafelo::Core::Session.start(viewer: viewer, access_token: "access", refresh_token: "refresh", access_expires_at: 5.minutes.from_now, grants: []); print "session_token=#{token}"')"
RAILS_ENV=test bin/rails server -p "$port" >"$log" 2>&1 &
rails_pid=$!
trap 'kill "$rails_pid" 2>/dev/null || true; rm -f "$log"' EXIT

for _ in $(seq 1 60); do
  if curl -sf -o /dev/null "http://localhost:${port}/en/component_catalog"; then break; fi
  sleep 1
done
curl -sf -o /dev/null "http://localhost:${port}/en/component_catalog"

PLAYWRIGHT_BASE_URL="http://localhost:${port}" npx playwright test "$@"
