#!/usr/bin/env bash
# script/ci/generator_smoke
set -euo pipefail
export BUNDLE_FROZEN=false # each new engine changes Gemfile.lock; other CI jobs, except the production image build (OPS-06), run with BUNDLE_FROZEN=true (WF-06)

# The engines this smoke creates. Their node_modules are ignored, so
# `git clean -fdq` leaves the directories behind and a second local run would
# generate into a stale one. Remove them by name before the clean-tree check
# and in the cleanup, leaving the rest of the ignored tree alone.
generated_engines=(smoke_party smoke_check smoke_other smoke_renamed)
for engine in "${generated_engines[@]}"; do rm -rf "engines/$engine"; done

# bin/ci runs this locally too: refuse to start on uncommitted or untracked work,
# because the cleanup below restores the whole tree.
if [ -n "$(git status --porcelain)" ]; then
  echo "generator_smoke: needs a clean working tree; commit or stash first" >&2
  git status --short >&2
  exit 1
fi

cleanup() {
  # The tree was clean at the start, so this removes only what the run created,
  # inside and outside engines/ (Gemfile.lock, generated aliases). The smoke's
  # own engines go first so their ignored node_modules go with them; other
  # ignored files stay.
  for engine in "${generated_engines[@]}"; do rm -rf "engines/$engine"; done
  git checkout -- . && git clean -fdq
  bundle install --quiet
}
trap cleanup EXIT # also after a failed step

# GEN-09 canary: every post-write step failure restores the pre-run tree.
bin/rails runner script/ci/generator_rollback

verify() {
  # Each generator ran its own post-write steps (GEN-09); prove they left nothing stale.
  script/ci/engine_graph --check
  for check in aliases permissions errors i18n contracts; do npm run "${check}:check"; done
  for engine in "$@"; do bin/check "$engine"; done
  npm run pages:check
}

verify_generated() {
  verify "$@"
  for engine in "$@"; do
    bin/rubocop "engines/$engine"
    if [ -d "spec/requests/$engine" ]; then bin/rubocop "spec/requests/$engine"; fi
  done
}

# Create: a domain engine, two product modules, a read page and a write page.
bin/rails generate rafelo:domain smoke_party
bin/rails generate rafelo:module smoke_check
bin/rails generate rafelo:module smoke_other
bin/rails generate rafelo:page smoke_check widgets --actions=index,new,edit
# The generated slice meets CT-08, FE-07, FE-01, and CT-10 (E6).
for file in \
  engines/smoke_check/app/frontend/pages/widgets/index.tsx \
  engines/smoke_check/app/frontend/pages/widgets/new.tsx \
  engines/smoke_check/app/frontend/containers/widgets/index_container.tsx \
  engines/smoke_check/app/frontend/components/widgets/form.tsx; do
  grep -q 'useSmokeCheckTranslation' "$file" || { echo "generated page misses its i18n hook (CT-08): $file" >&2; exit 1; }
done
for locale in $(bin/rails runner 'puts Rafelo::Core::Locales.available.map(&:to_s)'); do
  for key in title new empty name create back; do
    grep -q "^      $key:" "engines/smoke_check/config/locales/$locale.yml" || {
      echo "generated copy misses $key in $locale (CT-08)" >&2
      exit 1
    }
  done
done
if grep -R -n -E '<(button|input|select|textarea|a)([[:space:]>])' \
  engines/smoke_check/app/frontend/pages/widgets \
  engines/smoke_check/app/frontend/screens/widgets \
  engines/smoke_check/app/frontend/containers/widgets \
  engines/smoke_check/app/frontend/components/widgets; then
  echo "generated page renders a raw control (FE-07)" >&2
  exit 1
fi
if grep -R -n -E '(New Widget|No widgets yet|>Name<|>Back<|>Create<|>Save<)' \
  engines/smoke_check/app/frontend/pages/widgets \
  engines/smoke_check/app/frontend/screens/widgets \
  engines/smoke_check/app/frontend/containers/widgets \
  engines/smoke_check/app/frontend/components/widgets; then
  echo "generated page hard-codes copy (CT-08)" >&2
  exit 1
fi
grep -q 'WidgetsIndexScreen' engines/smoke_check/app/frontend/pages/widgets/index.tsx
grep -q 'WidgetsIndexContainer' engines/smoke_check/app/frontend/screens/widgets/index_screen.tsx
grep -q 'useForm' engines/smoke_check/app/frontend/containers/widgets/new_container.tsx
if grep -q 'useForm' engines/smoke_check/app/frontend/pages/widgets/new.tsx; then
  echo "generated page holds state instead of the container (FE-01)" >&2
  exit 1
fi
props=$(find engines/smoke_check/app/props -name widgets_index_props.rb -print -quit)
test -n "$props"
grep -q 'row\["id"\].to_s' "$props"
if grep -q '@items = items' "$props"; then
  echo "generated props carry the raw upstream hash (CT-10)" >&2
  exit 1
fi
test -f engines/smoke_check/spec/requests/widgets_spec.rb
test -f engines/smoke_check/app/frontend/components/widgets/list.test.tsx
test -f engines/smoke_check/app/frontend/components/widgets/form.test.tsx
gateway=$(find engines/smoke_check/app/gateways -name widgets_gateway.rb -print -quit)
test -n "$gateway"
grep -q 'upstream :api' "$gateway"
if grep -q -E '(/en/|localhost)' engines/smoke_check/spec/requests/widgets_spec.rb; then
  echo "generated spec hard-codes a locale or upstream host (#664)" >&2
  exit 1
fi
grep -q 'version: 1' engines/smoke_check/spec/requests/widgets_spec.rb
RAILS_ENV=test bin/rails db:prepare
verify_generated smoke_party smoke_check smoke_other
RAILS_ENV=test bundle exec rspec spec/upstream/drift_spec.rb spec/upstream/fixtures_spec.rb engines/smoke_check/spec

# Change: move the resource to the other module, then rename that module.
bin/rails generate rafelo:move_page smoke_check smoke_other widgets
# The move takes the whole slice with it (E5).
test -d engines/smoke_other/app/frontend/pages/widgets
test ! -d engines/smoke_check/app/frontend/pages/widgets
test -d engines/smoke_other/config/contracts/pages/widgets
test ! -d engines/smoke_check/config/contracts/pages/widgets
test -d engines/smoke_other/spec/fixtures/upstream/widgets
test ! -d engines/smoke_check/spec/fixtures/upstream/widgets
test -n "$(find engines/smoke_other/app/gateways -name widgets_gateway.rb -print -quit)"
test -z "$(find engines/smoke_check/app/gateways -name widgets_gateway.rb -print -quit)"
test -f engines/smoke_other/spec/requests/widgets_spec.rb
test ! -f engines/smoke_check/spec/requests/widgets_spec.rb
RAILS_ENV=test bundle exec rspec engines/smoke_other/spec/requests
bin/rails generate rafelo:rename_module smoke_other smoke_renamed
# The rename follows generated references but keeps URLs and permission keys (GEN-06).
grep -q 'useSmokeRenamedTranslation' engines/smoke_renamed/app/frontend/pages/widgets/index.tsx
grep -q 'name: "smoke_renamed"' engines/smoke_renamed/vitest.config.mts
grep -q 'name: "smoke_renamed:node"' engines/smoke_renamed/vitest.config.mts
grep -q 'MODULE_NAME = "smoke_renamed"' engines/smoke_renamed/app/frontend/public/index.ts
grep -q '^pages:' engines/smoke_renamed/config/budgets.yml
if grep -q 'smoke_other/' engines/smoke_renamed/config/budgets.yml; then
  echo "renamed engine still carries old budget keys (#666)" >&2
  exit 1
fi
grep -q 'key: :smoke_renamed' engines/smoke_renamed/config/module.rb
grep -q 'label_key: "smoke_renamed.nav.title"' engines/smoke_renamed/config/module.rb
grep -q 'path: "/smoke_other"' engines/smoke_renamed/config/module.rb
grep -q 'permission_prefixes:.*"smoke_other"' engines/smoke_renamed/config/module.rb
grep -q 'smoke_other/widgets' engines/smoke_renamed/spec/requests/widgets_spec.rb
if grep -R -q -E 'smoke_other/widgets|smoke_other\.' \
  engines/smoke_renamed/config \
  engines/smoke_renamed/app/frontend \
  engines/smoke_renamed/app/controllers \
  engines/smoke_renamed/app/props; then
  echo "renamed engine still carries the old page keys or test ids (#666)" >&2
  exit 1
fi
verify_generated smoke_check smoke_renamed
RAILS_ENV=test bundle exec rspec spec/upstream/drift_spec.rb spec/upstream/fixtures_spec.rb
