unless status.exitstatus.zero?
  warn "cops_canary: the legal fixture failed"
  warn output
  exit 1
end

def stdin_run(cop, path, source)
  Open3.capture2e("bundle", "exec", "rubocop", "--format", "json", "--only", cop, "--stdin", path,
                  stdin_data: source, chdir: ROOT)
end

