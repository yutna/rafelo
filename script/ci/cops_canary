#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"

ROOT = File.expand_path(Dir.pwd)
COPS = %w[
  Rafelo/FaradayOnlyInUpstreamClient
  Rafelo/NoTlsVerifyDisable
  Rafelo/ConfigXOnlyInCore
  Rafelo/CacheOnlyThroughScopedCache
  Rafelo/ReturnToOnlyInValueObject
].join(",")

bad = File.join(ROOT, "spec/enforcement/fixtures/cops/bad/example.rb")
legal = File.join(ROOT, "spec/enforcement/fixtures/cops/legal/example.rb")
abort "cops_canary: missing fixtures" unless File.file?(bad) && File.file?(legal)

output, status = Open3.capture2e("bundle", "exec", "rubocop", "--only", COPS, bad, chdir: ROOT)
unless !status.success? && COPS.split(",").all? { |cop| output.include?(cop) }
  warn "cops_canary: the bad fixture did not report every cop"
  warn output
  exit 1
end

output, status = Open3.capture2e("bundle", "exec", "rubocop", "--only", COPS, legal, chdir: ROOT)
unless status.success?
  warn "cops_canary: the legal fixture failed"
  warn output
  exit 1
end

def stdin_run(cop, path, source)
  Open3.capture2e("bundle", "exec", "rubocop", "--only", cop, "--stdin", path,
                  stdin_data: source, chdir: ROOT)
end

env_bad, env_bad_status = stdin_run("Rafelo/EnvOnlyInConfig", "app/models/env_canary.rb",
                                    "ENV[\"SECRET_KEY\"]\nENV.fetch(\"SECRET_KEY\")\nRails.application.credentials\nRails.application.credentials.dig(:database, :password)\n")
unless !env_bad_status.success? && env_bad.include?("Rafelo/EnvOnlyInConfig")
  warn "cops_canary: EnvOnlyInConfig did not report the app fixture"
  warn env_bad
  exit 1
end

env_legal, env_legal_status = stdin_run("Rafelo/EnvOnlyInConfig", "config/initializers/env_canary.rb",
                                        "ENV.fetch(\"SECRET_KEY\")\n")
unless env_legal_status.success?
  warn "cops_canary: EnvOnlyInConfig flagged config/"
  warn env_legal
  exit 1
end

concurrency_bad, concurrency_bad_status = stdin_run("Rafelo/ConcurrencyOnlyInExecutor",
                                                      "app/models/concurrency_canary.rb",
                                                      "Concurrent::FixedThreadPool.new(1)\n")
unless !concurrency_bad_status.success? && concurrency_bad.include?("Rafelo/ConcurrencyOnlyInExecutor")
  warn "cops_canary: ConcurrencyOnlyInExecutor did not report the app fixture"
  warn concurrency_bad
  exit 1
end
concurrency_executor, concurrency_executor_status = stdin_run(
  "Rafelo/ConcurrencyOnlyInExecutor", "engines/core/app/models/rafelo/core/executor.rb",
  "Concurrent::FixedThreadPool.new(1)\n"
)
unless concurrency_executor_status.success?
  warn "cops_canary: ConcurrencyOnlyInExecutor flagged the executor"
  warn concurrency_executor
  exit 1
end
concurrency_spec, concurrency_spec_status = stdin_run(
  "Rafelo/ConcurrencyOnlyInExecutor", "spec/core/concurrency_canary_spec.rb",
  "Concurrent::CyclicBarrier.new(2)\n"
)
unless concurrency_spec_status.success?
  warn "cops_canary: ConcurrencyOnlyInExecutor flagged a spec"
  warn concurrency_spec
  exit 1
end

current_bad, current_bad_status = stdin_run("Rafelo/CurrentAtTheEdge", "app/models/current_canary.rb",
                                            "Current.trace_id\nCurrent&.trace_id\n")
unless !current_bad_status.success? && current_bad.include?("Rafelo/CurrentAtTheEdge")
  warn "cops_canary: CurrentAtTheEdge did not report the app fixture"
  warn current_bad
  exit 1
end
current_controller, current_controller_status = stdin_run(
  "Rafelo/CurrentAtTheEdge", "app/controllers/current_canary_controller.rb", "Current.viewer\n"
)
unless current_controller_status.success?
  warn "cops_canary: CurrentAtTheEdge flagged a controller"
  warn current_controller
  exit 1
end
current_job, current_job_status = stdin_run(
  "Rafelo/CurrentAtTheEdge", "engines/core/app/jobs/rafelo/core/base_job.rb", "Current.request_id\n"
)
unless current_job_status.success?
  warn "cops_canary: CurrentAtTheEdge flagged BaseJob"
  warn current_job
  exit 1
end
current_middleware, current_middleware_status = stdin_run(
  "Rafelo/CurrentAtTheEdge", "engines/core/lib/rafelo/core/trace_middleware.rb", "Current.trace_id = 1\n"
)
unless current_middleware_status.success?
  warn "cops_canary: CurrentAtTheEdge flagged middleware"
  warn current_middleware
  exit 1
end

stream_bad, stream_bad_status = stdin_run("Rafelo/SendStreamOnlyInDownloads",
                                          "app/controllers/stream_canary_controller.rb", "send_stream(filename: \"x\")\n")
unless !stream_bad_status.success? && stream_bad.include?("Rafelo/SendStreamOnlyInDownloads")
  warn "cops_canary: SendStreamOnlyInDownloads did not report the app fixture"
  warn stream_bad
  exit 1
end
stream_legal, stream_legal_status = stdin_run(
  "Rafelo/SendStreamOnlyInDownloads", "engines/core/app/controllers/rafelo/core/download_controller.rb",
  "send_stream(filename: \"x\")\n"
)
unless stream_legal_status.success?
  warn "cops_canary: SendStreamOnlyInDownloads flagged the download controller"
  warn stream_legal
  exit 1
end

page_context_bad, page_context_bad_status = stdin_run(
  "Rafelo/PageContextThroughFactory", "app/controllers/page_context_canary_controller.rb",
  "Rafelo::Core::PageContext.new\n"
)
unless !page_context_bad_status.success? && page_context_bad.include?("Rafelo/PageContextThroughFactory")
  warn "cops_canary: PageContextThroughFactory did not report the app fixture"
  warn page_context_bad
  exit 1
end
page_context_legal, page_context_legal_status = stdin_run(
  "Rafelo/PageContextThroughFactory", "engines/core/app/models/rafelo/core/page_context_factory.rb",
  "Rafelo::Core::PageContext.new\n"
)
unless page_context_legal_status.success?
  warn "cops_canary: PageContextThroughFactory flagged the factory"
  warn page_context_legal
  exit 1
end

permission_bad, permission_bad_status = stdin_run(
  "Rafelo/NoPermissionLiterals", "app/policies/permission_canary_policy.rb",
  "permissions.allows?(\"orders:read\")\n"
)
unless !permission_bad_status.success? && permission_bad.include?("Rafelo/NoPermissionLiterals")
  warn "cops_canary: NoPermissionLiterals did not report the string fixture"
  warn permission_bad
  exit 1
end
permission_legal, permission_legal_status = stdin_run(
  "Rafelo/NoPermissionLiterals", "engines/example_orders/app/policies/rafelo/example_orders/order_policy.rb",
  "permissions.allows?(Rafelo::ExampleOrders::Permissions::ORDER_READ)\n"
)
unless permission_legal_status.success?
  warn "cops_canary: NoPermissionLiterals flagged the generated constant"
  warn permission_legal
  exit 1
end

env_engine_bad, env_engine_bad_status = stdin_run(
  "Rafelo/EnvOnlyInConfig", "engines/example_orders/lib/rafelo/example_orders/config.rb",
  "ENV.fetch(\"SECRET_KEY\")\n"
)
unless !env_engine_bad_status.success? && env_engine_bad.include?("Rafelo/EnvOnlyInConfig")
  warn "cops_canary: EnvOnlyInConfig did not report an engine lib file"
  warn env_engine_bad
  exit 1
end

warn "cops_canary: checked #{COPS.split(",").length + 6} cops"
