output, status = Open3.capture2e("bundle", "exec", "rubocop", "--format", "json", "--only", COPS, bad, chdir: ROOT)
unless status.exitstatus == 1 && COPS.split(",").all? { |cop| output.include?(cop) }
  warn "cops_canary: the bad fixture did not report every cop"
  warn output
  exit 1
end

