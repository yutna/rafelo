env_engine_bad, env_engine_bad_status = stdin_run(
  "Rafelo/EnvOnlyInConfig", "engines/example_orders/lib/rafelo/example_orders/config.rb",
  "ENV.fetch(\"SECRET_KEY\")\n"
)
unless !env_engine_bad_status.success? && env_engine_bad.include?("Rafelo/EnvOnlyInConfig")
  warn "cops_canary: EnvOnlyInConfig did not report an engine lib file"
  warn env_engine_bad
  exit 1
end

no_constantize_bad, no_constantize_bad_status = stdin_run(
  "Rafelo/NoConstantize", "engines/smoke_check/app/models/no_constantize_canary.rb",
  "Thing.constantize\nThing.safe_constantize\nThing.const_get(:Thing)\nbelongs_to :thing, class_name: \"Thing\"\n"
)
unless !no_constantize_bad_status.success? && no_constantize_bad.include?("Rafelo/NoConstantize")
  warn "cops_canary: NoConstantize did not report the engine fixture"
  warn no_constantize_bad
  exit 1
end
no_constantize_legal, no_constantize_legal_status = stdin_run(
  "Rafelo/NoConstantize", "engines/core/app/models/rafelo/core/modules.rb",
  "Thing.constantize\n"
)
unless no_constantize_legal_status.success?
  warn "cops_canary: NoConstantize flagged the registry"
  warn no_constantize_legal
  exit 1
end

date_bad, date_bad_status = stdin_run(
  "Rafelo/DateFormatterOnly", "engines/example_orders/app/models/date_canary.rb",
  "date.strftime(\"%Y\")\nI18n.l(date)\nl(date)\ndate.to_fs\ndate.to_formatted_s\n"
)
unless !date_bad_status.success? && date_bad.include?("Rafelo/DateFormatterOnly")
  warn "cops_canary: DateFormatterOnly did not report the engine app fixture"
  warn date_bad
  exit 1
end
date_legal, date_legal_status = stdin_run(
  "Rafelo/DateFormatterOnly", "engines/core/app/models/rafelo/core/date_formatter.rb",
  "date.strftime(\"%Y\")\n"
)
unless date_legal_status.success?
  warn "cops_canary: DateFormatterOnly flagged the formatter"
  warn date_legal
  exit 1
end

legacy_engine = File.join(ROOT, "engines", "smoke_legacy_canary")
begin
  FileUtils.mkdir_p(File.join(legacy_engine, "db", "migrate"))
  File.write(File.join(legacy_engine, "package.yml"),
             "metadata:\n  legacy_table_prefix: legacy\n")
  table_bad, table_bad_status = stdin_run(
    "Rafelo/EngineTablePrefix", "engines/smoke_legacy_canary/db/migrate/20260101000000_create_widgets.rb",
    "create_table :widgets do |t|\nend\n"
  )
  unless !table_bad_status.success? && table_bad.include?("Rafelo/EngineTablePrefix")
    warn "cops_canary: EngineTablePrefix did not report an unprefixed table"
    warn table_bad
    exit 1
  end
  table_legal, table_legal_status = stdin_run(
    "Rafelo/EngineTablePrefix", "engines/smoke_legacy_canary/db/migrate/20260101000000_create_widgets.rb",
    "create_table :smoke_legacy_canary_widgets do |t|\nend\n"
  )
  unless table_legal_status.success?
    warn "cops_canary: EngineTablePrefix flagged a prefixed table"
    warn table_legal
    exit 1
  end
  table_legacy, table_legacy_status = stdin_run(
    "Rafelo/EngineTablePrefix", "engines/smoke_legacy_canary/db/migrate/20260101000000_create_widgets.rb",
    "create_table :legacy_widgets do |t|\nend\n"
  )
  unless table_legacy_status.success?
    warn "cops_canary: EngineTablePrefix flagged the recorded legacy prefix"
    warn table_legacy
    exit 1
  end
ensure
  FileUtils.rm_rf(legacy_engine)
end

internals_bad, internals_bad_status = stdin_run(
  "Rafelo/NoKernelInternals", "engines/example_orders/app/models/internals_canary.rb",
  "Rafelo::Core::Internal::Thing\nRafelo::DesignSystem::Internal::Thing\n"
)
unless !internals_bad_status.success? && internals_bad.include?("Rafelo/NoKernelInternals")
  warn "cops_canary: NoKernelInternals did not report a non-kernel reference"
  warn internals_bad
  exit 1
end
internals_core, internals_core_status = stdin_run(
  "Rafelo/NoKernelInternals", "engines/core/app/models/rafelo/core/internals_canary.rb",
  "Rafelo::Core::Internal::Thing\n"
)
unless internals_core_status.success?
  warn "cops_canary: NoKernelInternals flagged the owning kernel"
  warn internals_core
  exit 1
end
internals_design_system, internals_design_system_status = stdin_run(
  "Rafelo/NoKernelInternals", "engines/design_system/app/models/internals_canary.rb",
  "Rafelo::DesignSystem::Internal::Thing\n"
)
unless internals_design_system_status.success?
  warn "cops_canary: NoKernelInternals flagged design_system"
  warn internals_design_system
  exit 1
end

warn "cops_canary: checked #{COPS.split(",").length + 10} cops"
