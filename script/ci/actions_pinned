#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "yaml"

root = Dir.pwd
OptionParser.new do |parser|
  parser.banner = "Usage: script/ci/actions_pinned [--root DIR]"
  parser.on("--root DIR") { |value| root = value }
end.parse!

root = File.expand_path(root)
abort "actions_pinned: root does not exist: #{root}" unless Dir.exist?(root)

files = Dir[File.join(root, ".github", "workflows", "*.{yml,yaml}")] +
        Dir[File.join(root, ".github", "actions", "**", "action.{yml,yaml}")]
abort "actions_pinned: no workflow or action files found" if files.empty?

USES_LINE = /(?:^|\s)["']?uses["']?\s*:\s*["']?([^"'\s#]+)["']?\s*(?:#\s*(.*))?/

def comments_by_uses(raw)
  raw.each_line.with_object({}) do |line, comments|
    match = line.match(USES_LINE)
    next unless match

    comments[match[1]] ||= []
    comments[match[1]] << match[2].to_s.strip
  end
end

def walk_steps(steps, &block)
  Array(steps).each do |step|
    next unless step.is_a?(Hash)

    block.call(step["uses"]) if step["uses"]
  end
end

errors = []
checks = 0
files.each do |path|
  relative = path.delete_prefix("#{root}/")
  raw = File.read(path)
  comments = comments_by_uses(raw)
  data = YAML.load_file(path, aliases: true)

  uses_values = []
  if data["jobs"].is_a?(Hash)
    data["jobs"].each do |_name, job|
      next unless job.is_a?(Hash)

      uses_values << job["uses"] if job["uses"]
      walk_steps(job["steps"]) { |value| uses_values << value }
    end
  end
  if data.dig("runs", "steps")
    walk_steps(data.dig("runs", "steps")) { |value| uses_values << value }
  end

  uses_values.each do |reference|
    checks += 1
    reference = reference.to_s
    location = "#{relative} uses #{reference}"
    next if reference.start_with?("./")

    if reference.start_with?("docker://")
      errors << "#{location}: docker image is not digest-pinned" unless reference.match?(/@sha256:[0-9a-f]{64}\z/)
      next
    end

    errors << "#{location}: not pinned to a full commit SHA" unless reference.match?(/@[0-9a-f]{40}\z/)
    if comments[reference].to_a.empty? || comments[reference].any?(&:empty?)
      errors << "#{location}: has no version comment"
    end
  end
end

abort "actions_pinned: inspected zero uses" if checks.zero?

if errors.any?
  errors.each { |error| warn "actions_pinned: #{error}" }
  warn "actions_pinned: checked #{checks} uses; errors=#{errors.length}"
  exit 1
end

warn "actions_pinned: checked #{checks} uses; errors=0"
