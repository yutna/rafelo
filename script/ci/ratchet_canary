#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"
require "open3"
require "rbconfig"
require "tmpdir"
require "yaml"

require_relative "ratchet_counts"

root = File.expand_path("../..", __dir__)
script = File.join(root, "script", "ci", "ratchet")
failures = 0
cases = 0

ROOT_KEYS = {
  "eslint_disable" => 0,
  "rubocop_disable" => 0,
  "use_no_memo" => 0,
  "skipped_tests" => 0,
  "clone_baseline_entries" => 0,
  "legacy_lint_paths" => 0,
  "clone_min_tokens" => 5
}.freeze
ENGINE_KEYS = {
  "eslint_disable" => 0,
  "rubocop_disable" => 0,
  "use_no_memo" => 0,
  "skipped_tests" => 0,
  "page_budget_overrides" => 0,
  "legacy_table_prefixes" => 0,
  "legacy_constants" => 0
}.freeze

def executable(name)
  ENV.fetch("PATH", "").split(File::PATH_SEPARATOR)
    .map { |entry| File.join(entry, name) }
    .find { |path| File.executable?(path) }
end

def git(dir, *args)
  output, error, status = Open3.capture3("git", "-C", dir, *args)
  abort "ratchet_canary: git #{args.join(' ')} failed: #{error}" unless status.success?

  output
end

def init_repo(dir)
  git(dir, "init", "-q")
  git(dir, "config", "user.email", "canary@rafelo.invalid")
  git(dir, "config", "user.name", "Canary")
  FileUtils.mkdir_p(File.join(dir, ".github"))
  File.write(File.join(dir, ".github", "CODEOWNERS"), "/engines/widgets/app/ @owner @second\n")
end

def write_yaml(path, data)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, data.to_yaml)
end

def write_root(dir, overrides = {})
  write_yaml(File.join(dir, "config", "ratchets.yml"), ROOT_KEYS.merge(overrides))
end

def write_engine(dir, overrides = {})
  write_yaml(File.join(dir, "engines", "widgets", "config", "ratchets.yml"),
             ENGINE_KEYS.merge(overrides))
end

def commit(dir, message)
  git(dir, "add", "-A")
  git(dir, "commit", "-q", "-m", message)
  git(dir, "rev-parse", "HEAD").strip
end

def reviews(dir, name, entries)
  path = File.join(dir, "#{name}.json")
  File.write(path, JSON.generate(entries))
  path
end

def run_case(script, dir, base, reviews_file, author: nil)
  args = [ script, "--root", dir, "--base", base ]
  args += [ "--reviews", reviews_file ] if reviews_file
  env = author ? { "PR_AUTHOR" => author } : {}
  output, status = Open3.capture2e(env, *args)
  [ status.exitstatus, output ]
end

def run_update(script, dir)
  output, status = Open3.capture2e(script, "--root", dir, "--update", "--no-clones")
  [ status.exitstatus, output ]
end

def git_show_failure(dir)
  bin = File.join(dir, "broken-bin")
  FileUtils.mkdir_p(bin)
  real_git = ENV.fetch("PATH", "").split(File::PATH_SEPARATOR)
    .map { |entry| File.join(entry, "git") }
    .find { |path| File.executable?(path) }
  abort "ratchet_canary: git is not on PATH" if real_git.nil?

  File.write(File.join(bin, "git"), <<~BASH)
    #!/usr/bin/env bash
    for arg in "$@"; do
      if [ "$arg" = "show" ]; then exit 1; fi
    done
    exec #{real_git} "$@"
  BASH
  File.chmod(0o755, File.join(bin, "git"))
  { "PATH" => "#{bin}:#{ENV.fetch("PATH", "")}" }
end

def check(failures, name, expected, status, output, needle = nil)
  ok = status == expected && (needle.nil? || output.include?(needle))
  return failures if ok

  warn "ratchet_canary: #{name}: exited #{status}, expected #{expected}: #{output}"
  failures + 1
end

Dir.mktmpdir("rafelo-ratchet-canary-") do |dir|
  init_repo(dir)
  write_root(dir)
  write_engine(dir)
  base = commit(dir, "base")

  # An invalid base and a failed read fail closed instead of hiding every rise.
  cases += 1
  status, output = run_case(script, dir, "deadbeef", nil)
  failures = check(failures, "invalid base", 1, status, output, "invalid base")

  cases += 1
  output, status = Open3.capture2e(git_show_failure(dir), script, "--root", dir, "--base", base)
  failures = check(failures, "failed ratchet read", 1, status.exitstatus, output, "cannot read")

  owner = reviews(dir, "owner", [ { "user" => { "login" => "owner" }, "state" => "APPROVED" } ])
  second = reviews(dir, "second", [ { "user" => { "login" => "second" }, "state" => "APPROVED" } ])
  outsider = reviews(dir, "outsider", [ { "user" => { "login" => "someone" }, "state" => "APPROVED" } ])
  rejected = reviews(dir, "rejected", [
    { "user" => { "login" => "owner" }, "state" => "APPROVED" },
    { "user" => { "login" => "owner" }, "state" => "CHANGES_REQUESTED" }
  ])
  empty = reviews(dir, "empty", [])

  # A recorded ceiling rise needs an owner who did not author the pull request.
  write_root(dir, "rubocop_disable" => 2)
  commit(dir, "root rise")
  cases += 1
  status, output = run_case(script, dir, base, empty, author: "outsider")
  failures = check(failures, "rise without approval", 1, status, output,
                   "a rise needs an approval from a CODEOWNERS owner other than the pull request author")
  cases += 1
  status, output = run_case(script, dir, base, owner, author: "outsider")
  failures = check(failures, "rise with an owner approval", 0, status, output)
  cases += 1
  status, output = run_case(script, dir, base, owner, author: "owner")
  failures = check(failures, "rise with the author's approval", 1, status, output,
                   "a rise needs an approval from a CODEOWNERS owner other than the pull request author")
  cases += 1
  status, output = run_case(script, dir, base, second, author: "owner")
  failures = check(failures, "rise with another owner's approval", 0, status, output)
  cases += 1
  status, output = run_case(script, dir, base, outsider, author: "outsider")
  failures = check(failures, "rise with a non-owner approval", 1, status, output,
                   "a rise needs an approval from a CODEOWNERS owner other than the pull request author")
  cases += 1
  status, output = run_case(script, dir, base, rejected, author: "outsider")
  failures = check(failures, "rise with a later change request", 1, status, output)

  # An engine-only rise fails; the engine file is aggregated, not just the root.
  write_root(dir)
  write_engine(dir, "skipped_tests" => 5)
  commit(dir, "engine rise")
  cases += 1
  status, output = run_case(script, dir, base, outsider, author: "outsider")
  failures = check(failures, "engine-only rise", 1, status, output, "engines/widgets/config/ratchets.yml:skipped_tests")

  # A fall passes without an approval.
  write_root(dir, "rubocop_disable" => 2)
  write_engine(dir)
  commit(dir, "before the fall")
  write_root(dir, "rubocop_disable" => 1)
  commit(dir, "fall")
  cases += 1
  status, output = run_case(script, dir, "HEAD~1", nil)
  failures = check(failures, "fall without approval", 0, status, output)

  # The real count is compared with the committed ceiling in check mode.
  FileUtils.mkdir_p(File.join(dir, "app"))
  File.write(File.join(dir, "app", "thing.rb"), "# rubocop:disable Rails/Thing\n")
  write_root(dir)
  commit(dir, "real count above the ceiling")
  cases += 1
  status, output = run_case(script, dir, base, nil)
  failures = check(failures, "real count above the ceiling", 1, status, output, "above its ceiling")

  # Raising the ceiling to the real value is a recorded rise that needs an owner.
  write_root(dir, "rubocop_disable" => 1)
  commit(dir, "raise the ceiling to the real count")
  cases += 1
  status, output = run_case(script, dir, base, owner, author: "outsider")
  failures = check(failures, "raise to the real count with an owner", 0, status, output)

  # --update lowers a ceiling and preserves settings.
  write_root(dir, "eslint_disable" => 3, "rubocop_disable" => 1)
  commit(dir, "update candidates")
  cases += 1
  status, output = run_update(script, dir)
  updated = YAML.load_file(File.join(dir, "config", "ratchets.yml"))
  cases += 1
  if status != 0 || updated["eslint_disable"] != 0 || updated["clone_min_tokens"] != 5
    failures += 1
    warn "ratchet_canary: update falls: exited #{status}: #{output}"
  end

  # --update reports a real rise and never raises a ceiling.
  write_root(dir)
  File.write(File.join(dir, "app", "rise.rb"), "# rubocop:disable Rails/Thing\n")
  commit(dir, "rise candidate")
  cases += 1
  status, output = run_update(script, dir)
  updated = YAML.load_file(File.join(dir, "config", "ratchets.yml"))
  cases += 1
  if status != 0 || updated["rubocop_disable"] != 0 || !output.include?("above its ceiling")
    failures += 1
    warn "ratchet_canary: update rise: exited #{status}: #{output}"
  end

  # An unknown author cannot approve a YAML rise. Both real-count files are
  # removed so only the approval check can fail the case: a real-count failure
  # would hide the approval path (WF-03).
  FileUtils.rm_f(File.join(dir, "app", "rise.rb"))
  FileUtils.rm_f(File.join(dir, "app", "thing.rb"))
  write_root(dir, "eslint_disable" => 3)
  commit(dir, "empty author rise")
  cases += 1
  status, output = run_case(script, dir, "HEAD~1", owner, author: "")
  failures = check(failures, "empty author fails closed", 1, status, output,
                   "a rise needs an approval from a CODEOWNERS owner other than the pull request author")
  if output.include?("above its ceiling")
    failures += 1
    warn "ratchet_canary: empty author was decided by a real-count failure, not the approval"
  end

  # A string ceiling cannot hide a rise.
  write_root(dir, "rubocop_disable" => "99")
  commit(dir, "string ceiling")
  cases += 1
  status, output = run_case(script, dir, base, nil)
  failures = check(failures, "non-integer ceiling", 1, status, output, "non-integer")
end

# --update counts the clone baseline from script/ci/clones when it exists and
# never raises a ceiling; check mode compares it with the committed ceiling.
Dir.mktmpdir("rafelo-ratchet-clones-") do |dir|
  init_repo(dir)
  write_root(dir, "clone_baseline_entries" => 10)
  write_engine(dir)
  FileUtils.mkdir_p(File.join(dir, "script", "ci"))
  File.write(File.join(dir, "script", "ci", "clones"), <<~'BASH')
    #!/usr/bin/env bash
    printf 'flay cross_engine=3\n'
    printf 'jscpd files=1 cross_engine=7\n'
  BASH
  File.chmod(0o755, File.join(dir, "script", "ci", "clones"))
  base = commit(dir, "base")

  cases += 1
  output, status = Open3.capture2e(script, "--root", dir, "--update")
  updated = YAML.load_file(File.join(dir, "config", "ratchets.yml"))
  cases += 1
  if status != 0 || updated["clone_baseline_entries"] != 7 ||
     !output.include?("clone_baseline_entries 10 -> 7")
    failures += 1
    warn "ratchet_canary: clone baseline update: exited #{status}: #{output}"
  end

  write_root(dir, "clone_baseline_entries" => 5)
  commit(dir, "lower the clone ceiling")
  cases += 1
  status, output = run_case(script, dir, "HEAD~1", nil)
  failures = check(failures, "clone baseline above the ceiling", 1, status, output,
                   "clone_baseline_entries is 7, above its ceiling 5")
end

# The merge_group payload has no pull request user: the author is resolved
# from the PR number, and a missing gh fails closed with the approval message
# and no network fallback (WF-03).
Dir.mktmpdir("rafelo-ratchet-merge-group-") do |dir|
  init_repo(dir)
  write_root(dir)
  write_engine(dir)
  base = commit(dir, "base")

  bin = File.join(dir, "bin")
  FileUtils.mkdir_p(bin)
  File.write(File.join(bin, "gh"), <<~'BASH')
    #!/usr/bin/env bash
    if [ "$1" = "api" ] && [ "$2" = "repos/canary/repo/pulls/7" ]; then echo owner; fi
  BASH
  File.chmod(0o755, File.join(bin, "gh"))

  write_root(dir, "eslint_disable" => 1)
  commit(dir, "rise")

  self_review = reviews(dir, "self", [ { "user" => { "login" => "owner" }, "state" => "APPROVED" } ])
  other_review = reviews(dir, "other", [ { "user" => { "login" => "second" }, "state" => "APPROVED" } ])
  env = {
    "PATH" => "#{bin}:#{ENV.fetch("PATH", "")}",
    "GITHUB_REPOSITORY" => "canary/repo",
    "PR_NUMBER" => "7",
    "HEAD_REF" => "refs/heads/pr-7-merge",
    "PR_AUTHOR" => ""
  }

  cases += 1
  output, status = Open3.capture2e(env, script, "--root", dir, "--base", base, "--reviews", self_review)
  failures = check(failures, "resolved author cannot approve", 1, status.exitstatus, output,
                   "a rise needs an approval from a CODEOWNERS owner other than the pull request author")

  cases += 1
  output, status = Open3.capture2e(env, script, "--root", dir, "--base", base, "--reviews", other_review)
  failures = check(failures, "resolved author with another owner", 0, status.exitstatus, output)

  no_gh = File.join(dir, "no-gh")
  FileUtils.mkdir_p(no_gh)
  FileUtils.ln_s(executable("git"), File.join(no_gh, "git"))
  FileUtils.ln_s(RbConfig.ruby, File.join(no_gh, "ruby"))
  cases += 1
  output, status = Open3.capture2e(env.merge("PATH" => no_gh.to_s), script, "--root", dir, "--base", base,
                                   "--reviews", other_review)
  failures = check(failures, "missing gh fails closed", 1, status.exitstatus, output,
                   "a rise needs an approval from a CODEOWNERS owner other than the pull request author")
end

# A new key is recorded at its real value; it is not a rise.
Dir.mktmpdir("rafelo-ratchet-new-key-") do |dir|
  init_repo(dir)
  write_root(dir)
  engine = ENGINE_KEYS.reject { |key, _| key == "legacy_constants" }
  write_yaml(File.join(dir, "engines", "widgets", "config", "ratchets.yml"), engine)
  base = commit(dir, "base without the new key")

  write_engine(dir)
  commit(dir, "record the new key")
  owner = reviews(dir, "owner", [ { "user" => { "login" => "owner" }, "state" => "APPROVED" } ])
  outsider = reviews(dir, "outsider", [ { "user" => { "login" => "someone" }, "state" => "APPROVED" } ])
  cases += 1
  status, output = run_case(script, dir, base, outsider)
  failures = check(failures, "new key at its real value", 0, status, output)

  # A new key with headroom above its real count needs an owner approval.
  write_engine(dir, "legacy_constants" => 999)
  commit(dir, "new key with headroom")
  cases += 1
  status, output = run_case(script, dir, base, outsider, author: "outsider")
  failures = check(failures, "new key with headroom", 1, status, output, "legacy_constants")
  cases += 1
  status, output = run_case(script, dir, base, owner, author: "outsider")
  failures = check(failures, "new key headroom with an owner approval", 0, status, output)
end

# A missing key in an engine file fails.
Dir.mktmpdir("rafelo-ratchet-missing-key-") do |dir|
  init_repo(dir)
  write_root(dir)
  write_engine(dir)
  path = File.join(dir, "engines", "widgets", "config", "ratchets.yml")
  data = YAML.load_file(path)
  data.delete("use_no_memo")
  File.write(path, data.to_yaml)
