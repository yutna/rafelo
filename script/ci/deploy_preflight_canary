#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

git init -q "$tmp"
mkdir -p "$tmp/config" "$tmp/.kamal" "$tmp/.github/workflows"
echo "RAILS_MASTER_KEY=dummy" > "$tmp/.kamal/secrets.example"
cat > "$tmp/.github/workflows/audits.yml" <<'YAML'
on:
  schedule:
    - cron: "0 6 * * *"
YAML
write_deploy() {
  cat > "$tmp/config/deploy.yml"
}
base() {
  cat <<'YAML'
service: rafelo
deploy_timeout: 120
env:
  secret:
    - RAILS_MASTER_KEY
servers:
  web:
    - 192.168.0.1
proxy:
  buffering:
    max_request_body: 1_048_576
YAML
}

base | write_deploy
"$root/script/ci/deploy_preflight" "$tmp" >/dev/null

if base | sed '/deploy_timeout/d' | write_deploy; then
  if "$root/script/ci/deploy_preflight" "$tmp" >/dev/null 2>&1; then
    echo "deploy_preflight_canary: missing deploy_timeout passed" >&2
    exit 1
  fi
fi

cat > "$tmp/config/deploy.yml" <<'YAML'
service: rafelo
deploy_timeout: 120
env:
  secret:
    - RAILS_MASTER_KEY
servers:
  web:
    - 192.168.0.1
    - 192.168.0.2
proxy:
  buffering:
    max_request_body: 1_048_576
YAML
if "$root/script/ci/deploy_preflight" "$tmp" >/dev/null 2>&1; then
  echo "deploy_preflight_canary: multi-host without boot.limit passed" >&2
  exit 1
fi

echo "GITHUB_TOKEN=x" > "$tmp/.kamal/secrets"
if "$root/script/ci/deploy_preflight" "$tmp" >/dev/null 2>&1; then
  echo "deploy_preflight_canary: a secrets file without RAILS_MASTER_KEY passed" >&2
  exit 1
fi
rm -f "$tmp/.kamal/secrets"

echo "deploy_preflight_canary: checked 4 cases"
