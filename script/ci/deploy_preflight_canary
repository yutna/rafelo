write_production_credentials() {
  local content="$1" key
  key="$(ruby -rsecurerandom -e 'puts SecureRandom.hex(16)')"
  PRODUCTION_KEY="$key"
  mkdir -p "$tmp/config/credentials"
  cp "$root/config/credentials/dummy.key" "$tmp/config/credentials/dummy.key"
  cp "$root/config/credentials/dummy.yml.enc" "$tmp/config/credentials/dummy.yml.enc"
  printf '%s' "$key" > "$tmp/config/credentials/production.key"
  cat > "$tmp/.kamal/secrets" <<'SECRETS'
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
SECRETS
  BUNDLE_GEMFILE="$root/Gemfile" bundle exec ruby -ractive_support \
    -ractive_support/encrypted_configuration -e '
      config = ActiveSupport::EncryptedConfiguration.new(
        config_path: ARGV[0], key_path: ARGV[1], env_key: "RAILS_MASTER_KEY", raise_if_missing_key: true
      )
      config.write(ARGV[2])
    ' "$tmp/config/credentials/production.yml.enc" "$tmp/config/credentials/production.key" "$content"
}

non_dummy_credentials_yaml() {
  BUNDLE_GEMFILE="$root/Gemfile" bundle exec ruby -ractive_support \
    -ractive_support/encrypted_configuration -ryaml -e '
      config = ActiveSupport::EncryptedConfiguration.new(
        config_path: ARGV[0], key_path: ARGV[1], env_key: "RAILS_MASTER_KEY", raise_if_missing_key: true
      )
      walk = lambda do |h|
        h.transform_values { |child| child.is_a?(Hash) ? walk.call(child) : "fixture-#{child}" }
      end
      print walk.call(config.config).to_yaml
    ' "$root/config/credentials/dummy.yml.enc" "$root/config/credentials/dummy.key"
}

dummy_credentials_yaml() {
  BUNDLE_GEMFILE="$root/Gemfile" bundle exec ruby -ractive_support \
    -ractive_support/encrypted_configuration -ryaml -e '
      config = ActiveSupport::EncryptedConfiguration.new(
        config_path: ARGV[0], key_path: ARGV[1], env_key: "RAILS_MASTER_KEY", raise_if_missing_key: true
      )
      print config.config.to_yaml
    ' "$root/config/credentials/dummy.yml.enc" "$root/config/credentials/dummy.key"
}

