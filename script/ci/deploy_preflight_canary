#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

git init -q "$tmp"
mkdir -p "$tmp/config" "$tmp/.kamal/hooks" "$tmp/.github/workflows" "$tmp/.devcontainer"

PRODUCTION_KEY=""
digest="$(printf 'a%.0s' {1..64})"

write_env() {
  cat > "$tmp/.env.ci.production" <<'ENV'
RAFELO_API_BASE_URL=http://127.0.0.1:9
RAILS_HOSTS=example.com
ENV
}

write_secrets() {
  cat > "$tmp/.kamal/secrets.example" <<'SECRETS'
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
SECRETS
}

write_hook() {
  cat > "$tmp/.kamal/hooks/pre-deploy" <<'HOOK'
#!/usr/bin/env sh
script/ci/deploy_preflight
HOOK
  chmod +x "$tmp/.kamal/hooks/pre-deploy"
}

write_audits() {
  cat > "$tmp/.github/workflows/audits.yml" <<'YAML'
on:
  schedule:
    - cron: "0 6 * * *"
YAML
}

write_dockerfile() {
  cat > "$tmp/Dockerfile" <<'DOCKER'
FROM ruby:4.0.9-slim AS base
USER 1000:1000
DOCKER
}

write_compose() {
  cat > "$tmp/.devcontainer/compose.yaml" <<YAML
services:
  postgres:
    image: postgres:18.6@sha256:$digest
YAML
}

write_single() {
  cat > "$tmp/config/deploy.yml" <<YAML
service: rafelo
deploy_timeout: 120
boot:
  limit: 1
image: rafelo
servers:
  web:
    - 192.168.0.1
proxy:
  buffering:
    max_request_body: 1048576
env:
  secret:
    - RAILS_MASTER_KEY
  clear:
    RAFELO_API_BASE_URL: https://api.example.com
    RAILS_HOSTS: app.example.com
    ACTIVE_STORAGE_SERVICE: local
    SOLID_QUEUE_IN_PUMA: true
    DB_HOST: rafelo-db
    DB_NAME: rafelo_production
    DB_USER: rafelo_runtime
    DB_MIGRATION_USER: rafelo_migrator
asset_path: /rails/public/vite
volumes:
  - rafelo_storage:/rails/storage
builder:
  arch: amd64
accessories:
  db:
    image: postgres:18.6@sha256:$digest
    env:
      secret:
        - POSTGRES_PASSWORD
YAML
}

write_multi() {
  cat > "$tmp/config/deploy.multi.yml" <<YAML
service: rafelo
deploy_timeout: 120
boot:
  limit: 1
image: rafelo
servers:
  web:
    hosts:
      - 192.168.0.1
      - 192.168.0.2
  job:
    hosts:
      - 192.168.0.1
    cmd: bin/jobs
proxy:
  buffering:
    max_request_body: 1048576
env:
  secret:
    - RAILS_MASTER_KEY
  clear:
    RAFELO_API_BASE_URL: https://api.example.com
    RAILS_HOSTS: app.example.com
    ACTIVE_STORAGE_SERVICE: amazon
    DB_HOST: db.example.com
    DB_NAME: rafelo_production
    DB_USER: rafelo_runtime
    DB_MIGRATION_USER: rafelo_migrator
    AWS_REGION: us-east-1
    AWS_BUCKET: rafelo-production
asset_path: /rails/public/vite
builder:
  arch: amd64
YAML
}

reset() {
  rm -rf "$tmp"
  mkdir -p "$tmp/config" "$tmp/.kamal/hooks" "$tmp/.github/workflows" "$tmp/.devcontainer"
  git init -q "$tmp"
  write_env
  write_secrets
  write_hook
  write_audits
  write_dockerfile
  write_compose
  write_single
  write_multi
  git -C "$tmp" add -A
}

edit_yaml() {
  local file="$1"
  local code="$2"
  ruby -ryaml -e 'file, code = ARGV; config = YAML.load_file(file); eval(code); File.write(file, YAML.dump(config))' "$file" "$code"
}

expect_pass() {
  local name="$1"
  if ! "$root/script/ci/deploy_preflight" "$tmp" >/dev/null 2>&1; then
    echo "deploy_preflight_canary: $name failed" >&2
    "$root/script/ci/deploy_preflight" "$tmp" >&2 || true
    exit 1
  fi
}

expect_fail() {
  local name="$1"
  if "$root/script/ci/deploy_preflight" "$tmp" >/dev/null 2>&1; then
    echo "deploy_preflight_canary: $name passed" >&2
    exit 1
  fi
}

expect_fail_with() {
  local name="$1" expected="$2" output
  if output=$("$root/script/ci/deploy_preflight" "$tmp" 2>&1); then
    echo "deploy_preflight_canary: $name passed" >&2
    exit 1
  fi
  if [[ "$output" != *"$expected"* ]]; then
    echo "deploy_preflight_canary: $name did not name $expected" >&2
    echo "$output" >&2
    exit 1
  fi
}

expect_fail_with_deploy() {
  local name="$1" expected="$2" output
  if output=$(RAILS_MASTER_KEY="$PRODUCTION_KEY" "$root/script/ci/deploy_preflight" "$tmp" --deploy 2>&1); then
    echo "deploy_preflight_canary: $name passed" >&2
    exit 1
  fi
  if [[ "$output" != *"$expected"* ]]; then
    echo "deploy_preflight_canary: $name did not name $expected" >&2
    echo "$output" >&2
    exit 1
  fi
}

expect_pass_with_deploy() {
  local name="$1"
  if ! RAILS_MASTER_KEY="$PRODUCTION_KEY" "$root/script/ci/deploy_preflight" "$tmp" --deploy >/dev/null 2>&1; then
    echo "deploy_preflight_canary: $name failed" >&2
    RAILS_MASTER_KEY="$PRODUCTION_KEY" "$root/script/ci/deploy_preflight" "$tmp" --deploy >&2 || true
    exit 1
  fi
}

expect_fail_with_deploy_env() {
  local name="$1" expected="$2" output
  if output=$(env -u RAILS_MASTER_KEY "$root/script/ci/deploy_preflight" "$tmp" --deploy 2>&1); then
    echo "deploy_preflight_canary: $name passed" >&2
    exit 1
  fi
  if [[ "$output" != *"$expected"* ]]; then
    echo "deploy_preflight_canary: $name did not name $expected" >&2
    echo "$output" >&2
    exit 1
  fi
}

expect_fail_with_deploy_key() {
  local name="$1" expected="$2" output
  if output=$(RAILS_MASTER_KEY=fixture "$root/script/ci/deploy_preflight" "$tmp" --deploy 2>&1); then
    echo "deploy_preflight_canary: $name passed" >&2
    exit 1
  fi
  if [[ "$output" != *"$expected"* ]]; then
    echo "deploy_preflight_canary: $name did not name $expected" >&2
    echo "$output" >&2
    exit 1
  fi
}

