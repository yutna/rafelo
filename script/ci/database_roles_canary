#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/bin"

fake_bundle() {
  printf '#!/usr/bin/env bash\necho "%s examples, 0 failures"\n' "$1" > "$tmp/bin/bundle"
  chmod +x "$tmp/bin/bundle"
}

fake_bundle 6
PATH="$tmp/bin:$PATH" "$root/script/ci/database_roles" >/dev/null

fake_bundle 10
PATH="$tmp/bin:$PATH" "$root/script/ci/database_roles" >/dev/null

fake_bundle 0
if PATH="$tmp/bin:$PATH" "$root/script/ci/database_roles" >/dev/null 2>&1; then
  echo "database_roles_canary: zero examples passed" >&2
  exit 1
fi

echo "database_roles_canary: checked 3 cases"
