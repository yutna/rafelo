#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"

root = Dir.pwd
OptionParser.new do |parser|
  parser.banner = "Usage: script/ci/test_selectors [--root DIR]"
  parser.on("--root DIR") { |value| root = value }
end.parse!

root = File.expand_path(root)
abort "test_selectors: root does not exist: #{root}" unless Dir.exist?(root)

# The TypeScript AST knows JSX text, regex literals, and comments, which a text
# mask cannot tell apart (TS-04, TS-07). TypeScript is already in the stack.
exec "node", File.join(__dir__, "test_selectors.mjs"), "--root", root
