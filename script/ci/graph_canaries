#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "open3"
require "optparse"

root = Dir.pwd
OptionParser.new do |parser|
  parser.banner = "Usage: script/ci/graph_canaries [--root DIR]"
  parser.on("--root DIR") { |value| root = value }
end.parse!

root = File.expand_path(root)
abort "graph_canaries: root does not exist: #{root}" unless Dir.exist?(root)

CANARY_ENGINES = %w[
  canary_alpha canary_beta canary_declared canary_kernel canary_undeclared
  canary_legal_alpha canary_legal_beta canary_consumer example_canary
].freeze
SNAPSHOT_FILES = %w[
  tsconfig.json tsconfig.tooling.json tsconfig.base.json
  app/frontend/tsconfig.json config/frontend_aliases.mts
  .dependency-cruiser.engines.generated.json engines/design_system/package.yml
].freeze

snapshot = SNAPSHOT_FILES.to_h do |path|
  full = File.join(root, path)
  [ path, File.file?(full) ? File.read(full) : nil ]
end

cleanup = lambda do
  CANARY_ENGINES.each { |engine| FileUtils.rm_rf(File.join(root, "engines", engine)) }
  %w[
    app/models/canary_private_reference.rb
    engines/core/app/models/rafelo/core/canary_cycle.rb
    engines/design_system/app/public/rafelo/design_system/public_canary.rb
    engines/design_system/app/public/rafelo/design_system/canary_cycle.rb
    engines/design_system/app/models/rafelo/design_system/private_canary.rb
    engines/design_system/app/models/rafelo/design_system/legal_core_use.rb
    engines/core/app/frontend/internal/secret.ts
  ].each { |path| FileUtils.rm_f(File.join(root, path)) }
  snapshot.each do |path, content|
    full = File.join(root, path)
    content.nil? ? FileUtils.rm_f(full) : File.write(full, content)
  end
end
at_exit { cleanup.call }

def write(root, path, content)
  full = File.join(root, path)
  FileUtils.mkdir_p(File.dirname(full))
  File.write(full, content)
end

def run(root, *command)
  Open3.capture2e(*command, chdir: root)
end

def assert_success(root, command, label)
  output, status = run(root, *command)
  return if status.success?

  warn "graph_canaries: #{label} failed"
  warn output
  exit 1
end

CANARY_ENGINES.each do |engine|
  write(root, "engines/#{engine}/package.yml", <<~YAML)
    enforce_dependencies: strict
    enforce_privacy: strict
    public_path: app/public/
    dependencies: []
  YAML
end
%w[canary_beta canary_declared].each do |engine|
  write(root, "engines/#{engine}/package.yml", <<~YAML)
    enforce_dependencies: strict
    enforce_privacy: strict
    public_path: app/public/
    dependencies:
      - engines/canary_alpha
  YAML
end
write(root, "engines/canary_kernel/package.yml", <<~YAML)
  enforce_dependencies: strict
  enforce_privacy: strict
  public_path: app/public/
  dependencies:
    - engines/core
YAML
write(root, "engines/canary_legal_alpha/package.yml", <<~YAML)
  enforce_dependencies: strict
  enforce_privacy: strict
  public_path: app/public/
  dependencies:
    - engines/core
YAML
write(root, "engines/canary_legal_beta/package.yml", <<~YAML)
  enforce_dependencies: strict
  enforce_privacy: strict
  public_path: app/public/
  dependencies:
    - engines/canary_legal_alpha
YAML

# Legal Ruby counterpart: a domain-shaped engine declares core and reads a public core constant.
write(root, "engines/canary_legal_alpha/app/public/rafelo/canary_legal_alpha/core_use.rb", <<~RUBY)
  module Rafelo
    module CanaryLegalAlpha
      class CoreUse
        def call = Rafelo::Core::PermissionSet.new([])
      end
    end
  end
RUBY
assert_success(root, %w[bin/packwerk check], "the legal Ruby graph check")

# Legal TypeScript counterpart: beta depends on alpha and reads its public file.
write(root, "engines/canary_legal_alpha/app/frontend/public/index.ts", "export const legalAlpha = \"legal\";\n")
write(root, "engines/canary_legal_beta/app/frontend/use.ts", <<~TS)
  import { legalAlpha } from "../../../canary_legal_alpha/app/frontend/public/index";

  export const used = legalAlpha;
TS
assert_success(root, %w[script/ci/engine_graph], "the legal graph generation")
assert_success(root, %w[script/ci/aliases], "the legal alias generation")
depcruise = File.join(root, "node_modules", ".bin", "depcruise")
abort "graph_canaries: depcruise is not installed" unless File.executable?(depcruise)
legal_ts_output, legal_ts_status = run(
  root, depcruise, "--config", ".dependency-cruiser.cjs", "engines/canary_legal_alpha", "engines/canary_legal_beta"
)
unless legal_ts_status.success?
  warn "graph_canaries: the legal TypeScript graph check failed"
  warn legal_ts_output
  exit 1
end

# Negative Ruby cases: mutual references, an undeclared dependency and a private constant.
write(root, "engines/design_system/app/public/rafelo/design_system/public_canary.rb", <<~RUBY)
  module Rafelo
    module DesignSystem
      class PublicCanary; end
    end
  end
RUBY
write(root, "engines/core/app/models/rafelo/core/canary_cycle.rb", <<~RUBY)
  module Rafelo
    module Core
      class CanaryCycle
        def call = Rafelo::DesignSystem::PublicCanary.new
      end
    end
  end
RUBY
write(root, "engines/design_system/app/public/rafelo/design_system/canary_cycle.rb", <<~RUBY)
  module Rafelo
    module DesignSystem
      class CanaryCycle
        def call = Rafelo::Core::PermissionSet.new([])
      end
    end
  end
RUBY
write(root, "engines/design_system/app/models/rafelo/design_system/private_canary.rb", <<~RUBY)
  module Rafelo
    module DesignSystem
      class PrivateCanary; end
    end
  end
RUBY
write(root, "engines/design_system/package.yml", <<~YAML)
  enforce_dependencies: strict
  enforce_privacy: strict
  public_path: app/public/
  dependencies: []
YAML
write(root, "app/models/canary_private_reference.rb", <<~RUBY)
  class CanaryPrivateReference
    def call = Rafelo::DesignSystem::PrivateCanary.new
  end
RUBY

ruby_output, ruby_status = run(root, "bin/packwerk", "check")
ruby_findings = [
  "engines/core/app/models/rafelo/core/canary_cycle.rb",
  "engines/design_system/app/public/rafelo/design_system/canary_cycle.rb",
  "app/models/canary_private_reference.rb",
  "Dependency violation",
  "Privacy violation"
]
ruby_failures = ruby_findings.reject { |needle| ruby_output.include?(needle) }
unless !ruby_status.success? && ruby_failures.empty?
  warn "graph_canaries: expected the Ruby graph checks to fail"
  warn ruby_output
  exit 1
end

FileUtils.rm_f(File.join(root, "app", "models", "canary_private_reference.rb"))
FileUtils.rm_f(File.join(root, "engines", "core", "app", "models", "rafelo", "core", "canary_cycle.rb"))
FileUtils.rm_f(File.join(root, "engines", "design_system", "app", "public", "rafelo", "design_system", "canary_cycle.rb"))
FileUtils.rm_f(File.join(root, "engines", "design_system", "app", "models", "rafelo", "design_system", "private_canary.rb"))
File.write(File.join(root, "engines", "design_system", "package.yml"), snapshot.fetch("engines/design_system/package.yml"))

# Negative TypeScript cases: a file cycle, an undeclared import, a non-public
# import through a relative path and through @engines, and a kernel internal import.
write(root, "engines/canary_alpha/app/frontend/public/index.ts", "export const alpha = \"alpha\";\n")
write(root, "engines/canary_alpha/app/frontend/internal/secret.ts", "export const secret = \"secret\";\n")
write(root, "engines/canary_alpha/app/frontend/internal/cycle_a.ts", <<~TS)
  import { cycleB } from "./cycle_b";

  export function cycleA(): string {
    return cycleB();
  }
TS
write(root, "engines/canary_alpha/app/frontend/internal/cycle_b.ts", <<~TS)
  import { cycleA } from "./cycle_a";

  export function cycleB(): string {
    return cycleA();
  }
TS
write(root, "engines/canary_beta/app/frontend/leak.ts", <<~TS)
  import { secret } from "../../../canary_alpha/app/frontend/internal/secret";

  export const leaked = secret;
TS
write(root, "engines/canary_declared/app/frontend/leak.ts", <<~TS)
  import { secret } from "../../../canary_alpha/app/frontend/internal/secret";
  import { alpha } from "@engines/canary_alpha/app/frontend/internal/secret";

  export const leaked = `${secret}:${alpha}`;
TS
write(root, "engines/canary_undeclared/app/frontend/leak.ts", <<~TS)
  import { alpha } from "../../../canary_alpha/app/frontend/public/index";

  export const leaked = alpha;
TS
write(root, "engines/core/app/frontend/internal/secret.ts", "export const kernelSecret = \"kernel\";\n")
write(root, "engines/canary_kernel/app/frontend/leak.ts", <<~TS)
  import { kernelSecret } from "../../../core/app/frontend/internal/secret";

  export const leaked = kernelSecret;
TS

ts_output, ts_status = run(
  root, depcruise, "--config", ".dependency-cruiser.cjs", "--output-type", "err",
  "engines/canary_alpha", "engines/canary_beta", "engines/canary_declared",
  "engines/canary_kernel", "engines/canary_undeclared"
)
ts_findings = [
  "no-circular",
  "canary_beta-imports-declared-surfaces-only",
  "canary_declared-imports-declared-surfaces-only",
  "canary_undeclared-imports-nothing-in-the-repository",
  "kernel-internals-stay-inside"
]
ts_failures = ts_findings.reject { |needle| ts_output.include?(needle) }
unless !ts_status.success? && ts_failures.empty?
  warn "graph_canaries: expected the TypeScript graph checks to fail"
  warn ts_output
  exit 1
end

# GEN-08: the TypeScript rule also refuses an import of an example engine.
write(root, "engines/example_canary/app/frontend/public/index.ts", "export const exampleCanary = \"example\";\n")
write(root, "engines/canary_legal_beta/app/frontend/example_leak.ts", <<~TS)
  import { exampleCanary } from "../../../example_canary/app/frontend/public/index";

  export const leaked = exampleCanary;
TS
example_ts_output, example_ts_status = run(
  root, depcruise, "--config", ".dependency-cruiser.cjs", "--output-type", "err", "engines/canary_legal_beta"
)
unless !example_ts_status.success? && example_ts_output.include?("nothing-depends-on-example-engines")
  warn "graph_canaries: expected the example-engine TypeScript rule to fail"
  warn example_ts_output
  exit 1
end
write(root, "script/example_leak.ts", <<~TS)
  import { exampleCanary } from "../engines/example_canary/app/frontend/public/index";

  export const leaked = exampleCanary;
TS
root_ts_output, root_ts_status = run(
  root, depcruise, "--config", ".dependency-cruiser.cjs", "--output-type", "err", "script"
)
unless !root_ts_status.success? && root_ts_output.include?("nothing-depends-on-example-engines")
  warn "graph_canaries: expected the root TypeScript example-engine rule to fail"
  warn root_ts_output
  exit 1
end
FileUtils.rm_f(File.join(root, "script", "example_leak.ts"))

FileUtils.rm_f(File.join(root, "engines", "canary_legal_beta", "app", "frontend", "example_leak.ts"))

# GEN-08: an engine outside example_* cannot depend on an example engine.
write(root, "engines/canary_consumer/package.yml", <<~YAML)
  enforce_dependencies: strict
  enforce_privacy: strict
  public_path: app/public/
  dependencies:
    - engines/example_customers
YAML
example_output, example_status = run(root, "script/ci/engine_graph")
unless !example_status.success? && example_output.include?("nothing outside example_* may depend on an example engine")
  warn "graph_canaries: expected the example-engine dependency guard to fail"
  warn example_output
  exit 1
end
FileUtils.rm_rf(File.join(root, "engines", "canary_consumer"))

CANARY_ENGINES.each { |engine| FileUtils.rm_rf(File.join(root, "engines", engine)) }
FileUtils.rm_f(File.join(root, "engines", "core", "app", "frontend", "internal", "secret.ts"))
assert_success(root, %w[script/ci/engine_graph], "the restored graph generation")
assert_success(root, %w[script/ci/aliases], "the restored alias generation")
assert_success(root, %w[bin/packwerk check], "the restored Ruby graph check")
assert_success(root, %W[#{depcruise} --config .dependency-cruiser.cjs app engines], "the restored TypeScript graph check")

warn "graph_canaries: legal public imports pass; Ruby cycle, undeclared dependency, privacy, TS cycle, non-public and @engines imports, kernel internals rejected"
