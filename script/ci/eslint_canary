def lint(eslint, root, path, content)
  Open3.capture3(
    eslint, "--stdin", "--stdin-filename", path, "--format", "json", "--max-warnings", "0",
    stdin_data: content, chdir: root
  )
end

CASES.each do |test|
  checks += 1
  content = File.read(File.join(FIXTURES, test[:fixture]))
  output, error, status = lint(eslint, root, test[:path], content)
  if status.exitstatus != 1
    failures += 1
    warn "eslint_canary: #{test[:name]} exited #{status.exitstatus}, expected 1: #{error.lines.last}"
    next
  end

  begin
    reports = JSON.parse(output).flat_map { |file| file["messages"] }
  rescue JSON::ParserError => e
    failures += 1
    warn "eslint_canary: #{test[:name]} returned invalid JSON: #{e.message}"
    next
  end

  reported = reports.map { |report| report["ruleId"] }
  missing = test[:rules] - reported.compact
  if missing.any?
    failures += 1
    warn "eslint_canary: #{test[:name]} did not report #{missing.join(', ')}; got #{reported.reject(&:nil?).uniq.join(', ')}"
  end
  if test[:count] && reports.length != test[:count]
    failures += 1
    warn "eslint_canary: #{test[:name]} reported #{reports.length} times, expected #{test[:count]}"
  end
end

LEGAL_CASES.each do |test|
  checks += 1
  content = File.read(File.join(FIXTURES, test[:fixture]))
  output, error, status = lint(eslint, root, test[:path], content)
  next if status.exitstatus.zero? && JSON.parse(output).all? { |file| file["messages"].empty? }

  failures += 1
  reports = begin
    JSON.parse(output).flat_map { |file| file["messages"] }.map { |report| report["ruleId"] }
  rescue JSON::ParserError
    []
  end
  warn "eslint_canary: legal #{test[:name]} failed (#{status.exitstatus}): #{reports.compact.uniq.join(', ')} #{error.lines.last}"
end

def rule(config, name)
  config.fetch("rules", {})[name]
end

def severity(config, name)
  value = rule(config, name)
  return 0 if value.nil?

  value.is_a?(Array) ? value.first : value
end

def options(config, name)
  value = rule(config, name)
  value.is_a?(Array) ? value[1..] : []
end

def import_entries(config)
  options(config, "no-restricted-imports").flat_map do |entry|
    Array(entry["paths"]) + Array(entry["patterns"])
  end
end

def import_named?(config, name)
  import_entries(config).any? { |entry| entry["name"] == name }
end

def import_group?(config, group)
  import_entries(config).any? { |entry| Array(entry["group"]).include?(group) }
end

def import_names(config, name)
  import_entries(config).select { |entry| entry["name"] == name }
                        .flat_map { |entry| Array(entry["importNames"]) + Array(entry["allowImportNames"]) }
end

def syntax_selectors(config)
  options(config, "no-restricted-syntax").filter_map { |entry| entry["selector"] }
end

def selector?(config, fragment)
  syntax_selectors(config).any? { |selector| selector.include?(fragment) }
end

PRINT_CONFIG.each do |test|
  checks += 1
  output, error, status = Open3.capture3(eslint, "--print-config", test[:path], chdir: root)
  unless status.success?
    failures += 1
    warn "eslint_canary: print-config failed for #{test[:path]}: #{error.lines.last}"
    next
  end

  config = JSON.parse(output)
  problems = []
  imports = test[:imports] || {}
  Array(imports[:names]).each { |name| problems << "missing import path #{name}" unless import_named?(config, name) }
  Array(imports[:groups]).each { |group| problems << "missing import group #{group}" unless import_group?(config, group) }
  Array(imports[:absent_names]).each { |name| problems << "unexpected import path #{name}" if import_named?(config, name) }
  Array(imports[:absent_groups]).each { |group| problems << "unexpected import group #{group}" if import_group?(config, group) }
  (test[:import_names] || {}).each do |name, names|
    missing = names - import_names(config, name)
    problems << "#{name} lacks importNames #{missing.join(', ')}" if missing.any?
  end
  case test[:properties]
  when :on then problems << "no-restricted-properties is off" unless severity(config, "no-restricted-properties") == 2
  when :off then problems << "no-restricted-properties is on" if severity(config, "no-restricted-properties") == 2
  end
  syntax = test[:syntax] || {}
  Array(syntax[:include]).each { |fragment| problems << "missing selector #{fragment}" unless selector?(config, fragment) }
  Array(syntax[:exclude]).each { |fragment| problems << "unexpected selector #{fragment}" if selector?(config, fragment) }
  case test[:forbid_elements]
  when :on then problems << "react/forbid-elements is off" unless severity(config, "react/forbid-elements") == 2
  when :off then problems << "react/forbid-elements is on" if severity(config, "react/forbid-elements") == 2
  end
  if test[:skip_rule] == :on && severity(config, "rafelo/skip-needs-issue") != 2
    problems << "rafelo/skip-needs-issue is off"
  end
  if test[:prefer_readonly] == :on && severity(config, "@typescript-eslint/prefer-readonly") != 2
    problems << "@typescript-eslint/prefer-readonly is off"
  end
  next if problems.empty?

  failures += 1
  warn "eslint_canary: print-config for #{test[:path]}: #{problems.join('; ')}"
end

def eslint_rules_at(eslint, root, path)
  output, _stderr, status = Open3.capture3(eslint, "--print-config", path, chdir: root)
  return [] unless status.success?
  JSON.parse(output).fetch("rules", {}).filter_map do |name, value|
    severity = value.is_a?(Array) ? value.first : value
    next unless severity.is_a?(Integer) && severity.positive?
    name if name.start_with?("rafelo/")
  end
rescue JSON::ParserError
  []
end

# The local plugin rules are enumerated from the config printed at real paths,
# and every discovered rule needs a canary case: a case with a bad fixture, a
# legal counterpart and the expected rule in `rules`.
local_rules = PRINT_CONFIG.flat_map { |test| eslint_rules_at(eslint, root, test[:path]) }.uniq
if local_rules.empty?
  failures += 1
  warn "eslint_canary: the local plugin exports no rules"
else
  checks += local_rules.length
  covered = CASES.flat_map { |test| Array(test[:rules]) }.uniq
  local_rules.each do |name|
    next if covered.include?(name)

    failures += 1
    warn "eslint_canary: local rule #{name} has no case"
  end
end

