#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "optparse"

root = Dir.pwd
OptionParser.new do |parser|
  parser.banner = "Usage: script/ci/apply_check [--root DIR]"
  parser.on("--root DIR") { |value| root = value }
end.parse!

root = File.expand_path(root)
abort "apply_check: root does not exist: #{root}; checked 0" unless Dir.exist?(root)

output, status = Open3.capture2("git", "-C", root, "ls-files", "*.css")
abort "apply_check: git ls-files failed; checked 0" unless status.success?

files = output.lines.map(&:strip).reject(&:empty?)
abort "apply_check: no CSS files found under #{root}; checked 0" if files.empty?

# A CSS comment is not an at-rule: `/* use @apply here */` outside
# design_system is prose. Strings stay in the output so a `/*` inside
# `content` never opens a comment, and newlines are kept so line numbers match
# the file (FE-06). An unquoted url() is one token: `url(a/*b)` holds data, not
# a comment, so a later @apply must still be seen.
def without_comments(source)
  code = +""
  state = :code
  quote = nil
  quote_return = :code
  index = 0
  # Tailwind keeps scanning after a `/*` that never closes; only a comment
  # with a `*/` after it is prose. One rindex keeps the lookahead linear.
  last_comment_close = source.rindex("*/")
  while index < source.length
    char = source[index]
    following = source[index + 1]
    case state
    when :code
      if char == "/" && following == "*" && last_comment_close && index < last_comment_close
        state = :comment
        index += 2
        next
      elsif char == '"' || char == "'"
        quote = char
        quote_return = :code
        state = :string
      else
        length = url_token_length(source, index)
        if length
          code << source[index, length]
          state = :url
          index += length
          next
        end
      end
      code << char
    when :comment
      if char == "*" && following == "/"
        state = :code
        index += 2
        next
      end
      code << "\n" if char == "\n"
    when :url
      if char == '"' || char == "'"
        quote = char
        quote_return = :url
        state = :string
      elsif char == "\\"
        code << char << following.to_s
        index += 2
        next
      elsif char == ")"
        state = :code
      end
      code << char
    when :string
      code << char
      if char == "\\"
        code << following.to_s if following
        index += 2
        next
      end
      state = quote_return if char == quote
    end
    index += 1
  end
  code
end

# Length of the `url(` token at index, including the `(`. CSS escapes in the
# name are decoded first (`u\72l(` is `url(`), and the token starts at an
# identifier boundary so `myurl(` is another function.
def url_token_length(source, index)
  return nil if index.positive? && source[index - 1] =~ /[A-Za-z0-9_-]/
  return nil unless source[index] =~ /[A-Za-z_\\-]/

  cursor = index
  decoded = +""
  while cursor < source.length
    char = source[cursor]
    if char == "\\"
      escaped, length = css_escape(source, cursor)
      return nil if length.zero?

      decoded << escaped
      cursor += length
    elsif char =~ /[A-Za-z0-9_-]/
      decoded << char
      cursor += 1
    else
      break
    end
    # Only an identifier that can still become `url` needs the rest of the
    # scan; this keeps an escape-heavy selector linear (TS-07).
    return nil unless "url".start_with?(decoded.downcase)
  end
  return nil unless source[cursor] == "("
  return nil unless decoded.casecmp("url").zero?

  cursor - index + 1
end

# [decoded text, bytes consumed] for the CSS escape at index.
def css_escape(source, index)
  following = source[index + 1]
  return [ nil, 0 ] if following.nil?

  if following =~ /[0-9A-Fa-f]/
    cursor = index + 1
    hex = +""
    while cursor < source.length && hex.length < 6 && source[cursor] =~ /[0-9A-Fa-f]/
      hex << source[cursor]
      cursor += 1
    end
    if cursor < source.length && source[cursor] =~ /\s/
      cursor += source[cursor] == "\r" && source[cursor + 1] == "\n" ? 2 : 1
    end
    value = hex.to_i(16)
    valid = value.positive? && value <= 0x10FFFF && !(0xD800..0xDFFF).cover?(value)
    decoded = valid ? [ value ].pack("U") : "\uFFFD"
    [ decoded, cursor - index ]
  elsif following == "\n" || following == "\r" || following == "\f"
    cursor = index + 2
    cursor += 1 if following == "\r" && source[cursor] == "\n"
    [ "", cursor - index ]
  else
    [ following, 2 ]
  end
end

findings = 0
files.each do |path|
  next if path.start_with?("engines/design_system/")

  absolute = File.join(root, path)
  next unless File.file?(absolute)

  without_comments(File.read(absolute)).lines(chomp: true).each_with_index do |line, index|
    next unless line.match?(/@apply\b/)

    puts "#{path}:#{index + 1}: apply-outside-design-system: @apply is allowed only in engines/design_system/ (FE-06)"
    findings += 1
  end
end

warn "apply_check: checked #{files.length} CSS files; findings=#{findings}"
exit(findings.zero? ? 0 : 1)
