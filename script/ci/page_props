#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "json"

root = Dir.pwd
matchers_mode = false
OptionParser.new do |parser|
  parser.banner = "Usage: script/ci/page_props [--root DIR] [--matchers]"
  parser.on("--root DIR") { |value| root = value }
  parser.on("--matchers") { matchers_mode = true }
end.parse!

root = File.expand_path(root)
abort "page_props: root does not exist: #{root}" unless Dir.exist?(root)

patterns = %W[
  #{root}/app/frontend/**/*.ts
  #{root}/app/frontend/**/*.tsx
  #{root}/engines/*/app/frontend/**/*.ts
  #{root}/engines/*/app/frontend/**/*.tsx
]
files = patterns.flat_map { |pattern| Dir[pattern] }.uniq.select { |path| File.file?(path) }
abort "page_props: no frontend files found under #{root}" if files.empty?

# FE-01: every render_page/render inertia name has a page and a schema.
# Enforcement fixtures exercise only the partial-key rule.
page_names = []
page_failures = 0
all_pages = []
unless root.include?("spec/enforcement/fixtures")
ruby_files = Dir[File.join(root, "app/**/*.rb")] + Dir[File.join(root, "engines/*/app/**/*.rb")]
page_names = ruby_files.flat_map do |path|
  File.read(path).scan(/(?:render_page|render inertia:)\s*["']([^"']+)["']/).flatten
end.uniq
page_names.each do |name|
  candidates = [ File.join(root, "app/frontend/pages/#{name}.tsx") ] +
               Dir[File.join(root, "engines/*/app/frontend/pages/**/#{File.basename(name)}.tsx")].select do |path|
                 path.include?("/pages/#{name.sub(%r{\A[^/]+/}, "")}.tsx")
               end
  path = candidates.find { |candidate| File.file?(candidate) }
  if path.nil?
    puts "#{name}: render target has no page file"
    page_failures += 1
  elsif !File.file?(path.sub(/\.tsx\z/, ".schema.ts"))
    puts "#{name}: page has no .schema.ts"
    page_failures += 1
  end
end
all_pages = files.select { |path| path.include?("/pages/") && path.end_with?(".tsx") && !path.end_with?(".test.tsx") }
all_pages.each do |path|
  next if File.file?(path.sub(/\.tsx\z/, ".schema.ts"))

  puts "#{path.delete_prefix("#{root}/")}: page has no .schema.ts"
  page_failures += 1
end
end
if page_failures.positive?
  warn "page_props: #{page_failures} page contract failure(s)"
  exit 1
end
warn "page_props: checked #{page_names.length} render target(s) and #{all_pages.length} page file(s)"

if matchers_mode
  contract_files = Dir[File.join(root, "config/contracts/pages/**/*.json")] +
                   Dir[File.join(root, "engines/*/config/contracts/pages/**/*.json")]
  recorded = Dir[File.join(root, "tmp/page_matchers/*.json")].flat_map do |path|
    JSON.parse(File.read(path))
  rescue JSON::ParserError
    []
  end
  abort "page_props: no page matcher records; run RSpec first" if recorded.empty?

  by_page = recorded.group_by { |entry| entry["page"] }
  contract_key = lambda do |path|
    if (match = path.match(%r{/engines/([^/]+)/config/contracts/pages/(.+)\.json\z}))
      "#{match[1]}/#{match[2]}"
    else
      path.split("/config/contracts/pages/").last.delete_suffix(".json")
    end
  end
  contract_keys = contract_files.map { |path| contract_key.call(path) }
  unknown_pages = by_page.keys - contract_keys
  unknown_pages.each do |key|
    puts "#{key}: matcher record has no page contract"
  end
  failures = unknown_pages.length
  contract_files.sort.each do |path|
    key = contract_key.call(path)
    names = by_page.fetch(key, []).map { |entry| entry["matcher"] }.uniq
    required = %w[match_page_schema within_budgets be_within_props_budget have_resolvable_hrefs]
    schema = JSON.parse(File.read(path))
    required << "match_policy_capabilities" if schema.dig("properties", "can", "properties")&.any?
    missing = required - names
    next if missing.empty?

    puts "#{key}: missing matchers #{missing.join(', ')}"
    failures += 1
  end
  if failures.positive?
    warn "page_props: #{failures} page(s) missing matcher records"
    exit 1
  end

  warn "page_props: checked #{contract_files.length} page contract(s)"
  exit 0
end

findings = 0
files.each do |path|
  relative = path.delete_prefix("#{root}/")
  lines = File.readlines(path, chomp: true)
  index = 0
  while index < lines.length
    line = lines[index]
    unless line.match?(/\b(?:only|except|deferred|optional|merge|once)\s*:/)
      index += 1
      next
    end

    block = line.dup
    depth = line.count("[") - line.count("]")
    cursor = index
    while depth.positive? && cursor + 1 < lines.length
      cursor += 1
      block << "\n#{lines[cursor]}"
      depth += lines[cursor].count("[") - lines[cursor].count("]")
    end

    block.scan(/["']([^"']+)["']/).flatten.each do |key|
      next unless key.include?(".")

      puts "#{relative}:#{index + 1}: multi-word partial-reload key #{key.inspect}"
      findings += 1
    end
    index = cursor + 1
  end
end

warn "page_props: checked #{files.length} files; findings=#{findings}"
exit(findings.zero? ? 0 : 1)
