#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "open3"
require "tmpdir"

root = File.expand_path("../..", __dir__)
script = File.join(root, "script", "ci", "release")
failures = 0
cases = 0

def git(dir, *args)
  output, error, status = Open3.capture3("git", "-C", dir, *args)
  abort "release_canary: git #{args.join(' ')} failed: #{error}" unless status.success?

  output
end

def run_case(script, dir, version, tags, arguments, env = {})
  File.write(File.join(dir, "VERSION"), version)
  tag_file = File.join(dir, "tags.txt")
  File.write(tag_file, tags.join("\n") + (tags.empty? ? "" : "\n"))
  output, status = Open3.capture2e(
    { "GITHUB_REPOSITORY" => "canary/repo", "RELEASE_SHA" => "a" * 40 }.merge(env),
    script, "--root", dir, "--tag-list", tag_file, *arguments
  )
  [ status.exitstatus, output ]
end

def expect(name, cases, failures, status, expected, output, pattern = nil)
  if status != expected || (pattern && !output.match?(pattern))
    failures += 1
    warn "release_canary: #{name}: exited #{status}, expected #{expected}: #{output}"
  end
  [ cases + 1, failures ]
end

Dir.mktmpdir("rafelo-release-canary-") do |dir|
  FileUtils.mkdir_p(File.join(dir, "spec", "fixtures", "formats", "v0.20.0"))
  FileUtils.mkdir_p(File.join(dir, "config", "locales"))
  File.write(File.join(dir, "config", "locales", "en.yml"), "en:\n  invoices: Invoices\n")

  tags = [ "v0.18.0", "v0.19.0" ]

  [ "bad", "0.20", "v0.20.0", "1.2.3.4" ].each do |version|
    cases += 1
    status, output = run_case(script, dir, version, tags, [ "--check" ])
    cases, failures = expect("format #{version.inspect}", cases - 1, failures, status, 1, output)
  end

  cases += 1
  status, output = run_case(script, dir, "0.20.0", tags, [ "--check" ])
  cases, failures = expect("higher version", cases - 1, failures, status, 0, output, /higher than v0\.19\.0/)

  FileUtils.rm_rf(File.join(dir, "spec", "fixtures", "formats", "v0.20.0"))
  cases += 1
  status, output = run_case(script, dir, "0.20.0", tags, [ "--check" ])
  cases, failures = expect("missing formats check", cases - 1, failures, status, 1, output, /formats\/v0\.20\.0 is missing/)
  FileUtils.mkdir_p(File.join(dir, "spec", "fixtures", "formats", "v0.20.0"))

  cases += 1
  status, output = run_case(script, dir, "0.19.0", tags, [ "--check" ])
  cases, failures = expect("existing tag", cases - 1, failures, status, 1, output, /already exists/)

  cases += 1
  status, output = run_case(script, dir, "0.17.0", tags, [ "--check" ])
  cases, failures = expect("lower version", cases - 1, failures, status, 1, output, /not higher/)

  cases += 1
  status, output = run_case(script, dir, "0.20.0", tags, [ "--release-exists", "no", "--dry-run" ])
  cases, failures = expect("create", cases - 1, failures, status, 0, output, /"tag_name":"v0\.20\.0".*target_commitish/)

  cases += 1
  status, output = run_case(script, dir, "0.20.0", tags, [ "--release-exists", "yes", "--dry-run" ])
  cases, failures = expect("release exists", cases - 1, failures, status, 0, output, /nothing to release/)

  cases += 1
  status, output = run_case(script, dir, "0.20.0", [ "v0.19.0", "v0.20.0" ], [ "--release-exists", "no", "--dry-run" ])
  cases, failures = expect("tag without a release", cases - 1, failures, status, 0, output, /"tag_name":"v0\.20\.0"/)
  if output.include?("target_commitish")
    failures += 1
    warn "release_canary: tag without a release must not move the tag"
  end

  FileUtils.rm_rf(File.join(dir, "spec", "fixtures", "formats", "v0.20.0"))
  cases += 1
  status, output = run_case(script, dir, "0.20.0", tags, [ "--release-exists", "no", "--dry-run" ])
  cases, failures = expect("missing formats", cases - 1, failures, status, 1, output, /formats\/v0\.20\.0 is missing/)

  FileUtils.mkdir_p(File.join(dir, "spec", "fixtures", "formats", "v0.20.0"))
  File.write(File.join(dir, "config", "locales", "en.yml"), "en:\n  invoices: \"[th] Invoices\"\n")
  cases += 1
  status, output = run_case(script, dir, "0.20.0", tags, [ "--release-exists", "no", "--dry-run" ])
  cases, failures = expect("locale placeholder", cases - 1, failures, status, 1, output, /locale placeholders/)

  cases += 1
  status, output = run_case(script, dir, "0.20.0", tags, [ "--check" ])
  cases, failures = expect("locale placeholder check", cases - 1, failures, status, 1, output, /locale placeholders/)
end

# The pull request reading (WF-05): CI reads a pull request's changes from the
# tested merge commit against its first parent; a release bump the base already
# carries reads as unchanged.
Dir.mktmpdir("rafelo-release_check-merge-canary-") do |dir|
  check = File.join(root, "script", "ci", "release_check")

  git(dir, "init", "-q")
  git(dir, "config", "user.email", "canary@rafelo.invalid")
  git(dir, "config", "user.name", "Canary")
  branch = git(dir, "symbolic-ref", "--short", "HEAD").strip
  FileUtils.mkdir_p(File.join(dir, "engines", "core", "base"))
  File.write(File.join(dir, "engines", "core", "base", "base.rb"), "class Base; end\n")
  File.write(File.join(dir, "VERSION"), "0.1.0\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "base")
  base = git(dir, "rev-parse", "HEAD").strip

  # The base (first parent of the merge commit) carries the release bump.
  File.write(File.join(dir, "VERSION"), "0.2.0\n")
  File.write(File.join(dir, "engines", "core", "base", "release.rb"), "class Release; end\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "release bump")
  bump = git(dir, "rev-parse", "HEAD").strip

  # The branch under test fell behind main and adds a non-engine path.
  git(dir, "checkout", "-q", "-b", "branch-under-test", base)
  FileUtils.mkdir_p(File.join(dir, "docs"))
  File.write(File.join(dir, "docs", "under-test.md"), "# under test\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "branch change")
  git(dir, "checkout", "-q", branch)
  git(dir, "merge", "-q", "--no-ff", "branch-under-test", "-m", "merge branch under test")

  if git(dir, "rev-parse", "HEAD^1").strip != bump
    failures += 1
    warn "release_canary: the merge commit's first parent is not the bump commit (verify the parent order of GitHub's test merge commit when adopting)"
  end

  cases += 1
  output, status = Open3.capture2e(check, "--root", dir, "--base", "HEAD^1")
  cases, failures = expect("merge commit carries the bump in the base", cases - 1, failures, status.exitstatus, 0, output, /VERSION is unchanged/)
end

# The release commit's push CI: the milestone-close caller already created
# the tag, so the check accepts it when it points at HEAD.
Dir.mktmpdir("rafelo-release-check-") do |dir|
  check = File.join(root, "script", "ci", "release_check")

  git(dir, "init", "-q")
  git(dir, "config", "user.email", "canary@rafelo.invalid")
  git(dir, "config", "user.name", "Canary")
  File.write(File.join(dir, "VERSION"), "0.1.0\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "base")
  base = git(dir, "rev-parse", "HEAD").strip

  File.write(File.join(dir, "VERSION"), "0.2.0\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "release")
  git(dir, "tag", "-a", "v0.2.0", "-m", "v0.2.0")

  cases += 1
  output, status = Open3.capture2e(check, "--root", dir, "--base", base)
  cases, failures = expect("current release tag", cases - 1, failures, status.exitstatus, 0, output, /current release commit/)

  File.write(File.join(dir, "VERSION"), "0.3.0\n")
  git(dir, "add", ".")
  git(dir, "commit", "-q", "-m", "next release")
  git(dir, "tag", "-a", "v0.3.0", "-m", "v0.3.0", "HEAD~1")
  FileUtils.mkdir_p(File.join(dir, "spec", "fixtures", "formats", "v0.3.0"))

  cases += 1
  output, status = Open3.capture2e(check, "--root", dir, "--base", "HEAD~1")
  cases, failures = expect("tag at another commit", cases - 1, failures, status.exitstatus, 1, output, /already exists/)
end

if failures.positive?
  warn "release_canary: checked #{cases} cases; failures=#{failures}"
  exit 1
end

warn "release_canary: checked #{cases} cases; failures=0"
