#!/usr/bin/env bash
set -euo pipefail

root="$(pwd)"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --root) root="$2"; shift 2 ;;
    *) echo "engine_specs: unknown argument $1" >&2; exit 1 ;;
  esac
done
cd "$root"

selected="${AFFECTED_ENGINES:-}"
filtered=false
if [ -n "$selected" ]; then
  filtered=true
  spec_dirs=()
  IFS=',' read -ra names <<< "$selected"
  for name in "${names[@]}"; do
    if [ ! -d "engines/$name" ]; then
      echo "engine_specs: unknown engine: $name" >&2
      exit 1
    fi
    if [ -d "engines/$name/spec" ]; then
      spec_dirs+=("engines/$name/spec")
    fi
  done
else
  mapfile -t spec_dirs < <(find engines -maxdepth 2 -type d -name spec | sort)
fi

if [ "${#spec_dirs[@]}" -eq 0 ]; then
  if [ "$filtered" = true ]; then
    echo "engine_specs: selected engines have no spec directories"
    exit 0
  fi
  echo "engine_specs: checked 0 engine spec directories" >&2
  exit 1
fi

bundle exec rspec "${spec_dirs[@]}"
