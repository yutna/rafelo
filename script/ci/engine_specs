#!/usr/bin/env bash
set -euo pipefail

root="$(pwd)"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --root) root="$2"; shift 2 ;;
    *) echo "engine_specs: unknown argument $1" >&2; exit 1 ;;
  esac
done
cd "$root"

selected="${AFFECTED_ENGINES:-}"
if [ -n "$selected" ]; then
  spec_dirs=()
  IFS=',' read -ra names <<< "$selected"
  for name in "${names[@]}"; do
    dir="engines/$name/spec"
    if [ ! -d "$dir" ]; then
      echo "engine_specs: unknown engine or missing spec directory: $name" >&2
      exit 1
    fi
    spec_dirs+=("$dir")
  done
else
  mapfile -t spec_dirs < <(find engines -maxdepth 2 -type d -name spec | sort)
fi

if [ "${#spec_dirs[@]}" -eq 0 ]; then
  echo "engine_specs: checked 0 engine spec directories" >&2
  exit 1
fi

bundle exec rspec "${spec_dirs[@]}"
