#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "optparse"

root = Dir.pwd
OptionParser.new do |parser|
  parser.banner = "Usage: script/ci/fan_in_canary [--root DIR]"
  parser.on("--root DIR") { |value| root = value }
end.parse!

root = File.expand_path(root)
abort "fan_in_canary: root does not exist: #{root}" unless Dir.exist?(root)

cases = [
  { name: "empty product set", fixture: "empty", expected: "no product modules", status: 0 },
  { name: "within the budget", fixture: "legal", expected: "errors=0", status: 0 },
  { name: "over the budget", fixture: "over", expected: "has 2 dependents > 1", status: 1 }
]

failures = 0
cases.each do |test_case|
  fixture = File.join(root, "spec", "enforcement", "fixtures", "fan_in", test_case[:fixture])
  abort "fan_in_canary: missing #{fixture}" unless Dir.exist?(fixture)

  output, status = Open3.capture2e(
    RbConfig.ruby, File.join(root, "script", "ci", "fan_in"), "--root", fixture
  )
  next if status.exitstatus == test_case[:status] && output.include?(test_case[:expected])

  warn "fan_in_canary: #{test_case[:name]}: expected status #{test_case[:status]} and #{test_case[:expected].inspect}"
  warn output
  failures += 1
end

warn "fan_in_canary: checked #{cases.length} cases; failures=#{failures}"
exit(failures.zero? ? 0 : 1)
