  path = File.join(root, "script", "ci", script)
  abort "enforcement_canaries: missing canary script script/ci/#{script}" unless File.file?(path)
  abort "enforcement_canaries: script/ci/#{script} is not executable" unless File.executable?(path)
  abort "enforcement_canaries: script/ci/#{script} is not wired into config/ci.rb" unless config_ci.include?("script/ci/#{script}")
end
warn "enforcement_canaries: checked #{CANARY_SCRIPTS.length} canary scripts"

