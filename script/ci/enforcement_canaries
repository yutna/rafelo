    script: "script/ci/skips",
    bad_args: [ "--root", "ROOT" ],
    legal_args: [ "--root", "ROOT" ],
    expected: "skip-needs-issue"
  },
  {
    check: "test_selectors",
    name: "bad-selector",
    bad: "spec/enforcement/fixtures/selectors/bad",
    legal: "spec/enforcement/fixtures/selectors/legal",
    script: "script/ci/test_selectors",
    bad_args: [ "--root", "ROOT" ],
    legal_args: [ "--root", "ROOT" ],
    expected: "bad-selector"
  },
  {
    check: "workflow_policy",
    name: "write allow-list",
    bad: "spec/enforcement/fixtures/workflow/write",
    legal: "spec/enforcement/fixtures/workflow/legal",
    script: "script/ci/workflow_policy",
    bad_args: [ "--root", "ROOT" ],
    legal_args: [ "--root", "ROOT" ],
    expected: "outside the allow-list"
  },
