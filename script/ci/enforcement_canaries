    script: "script/ci/frontend_boundary",
    bad_args: [ "--root", "ROOT" ],
    legal_args: [ "--root", "ROOT" ],
    expected: "only allowed in layouts"
  },
  {
    check: "page_props",
    name: "multi-word partial key",
    bad: "spec/enforcement/fixtures/page_props/bad",
    legal: "spec/enforcement/fixtures/page_props/legal",
    script: "script/ci/page_props",
    bad_args: [ "--root", "ROOT" ],
    legal_args: [ "--root", "ROOT" ],
    expected: "multi-word partial-reload key"
  },
  # A canary case (canary script, rules) per discovered name: cops,
  # dependency-cruiser rules and ESLint rules are covered by the `rules` of
  # these cases instead of hand-maintained lists or substring mentions.
  {
    check: "cops",
    name: "Rafelo cops canary",
    script: "script/ci/cops_canary",
    rules: cop_names
  },
  {
    check: "graph_canaries",
    name: "dependency-cruise rules canary",
    script: "script/ci/graph_canaries",
    rules: depcruise_rules
  },
  {
    check: "eslint",
    name: "local ESLint rules canary",
    script: "script/ci/eslint_canary",
    rules: Rafelo::ESLintCanary.cases(root).flat_map { |eslint_case| Array(eslint_case[:rules]) }.uniq
  }
].freeze

abort "enforcement_canaries: no canaries configured" if canaries.empty?
missing_checks = REQUIRED_CHECKS - canaries.map { |canary| canary[:check] }
abort "enforcement_canaries: no canary for #{missing_checks.join(', ')}" if missing_checks.any?

covered = canaries.flat_map { |canary| Array(canary[:rules]) }.uniq
missing = (cop_names + depcruise_rules + eslint_rules).reject { |name| covered.include?(name) }
abort "enforcement_canaries: no canary for #{missing.join(', ')}" if missing.any?

wired = canaries.map { |canary| canary[:script] }.uniq
missing_wiring = wired.reject { |script| config_ci.include?(script) }
abort "enforcement_canaries: canary script not wired into config/ci.rb: #{missing_wiring.join(', ')}" if missing_wiring.any?

warn "enforcement_canaries: checked #{cop_names.length} Rafelo cops: #{cop_names.join(', ')}"
warn "enforcement_canaries: checked #{depcruise_rules.length} dependency-cruise rules: #{depcruise_rules.join(', ')}"
warn "enforcement_canaries: checked #{eslint_rules.length} local ESLint rules: #{eslint_rules.join(', ')}"
warn "enforcement_canaries: checked #{wired.length} canary scripts"

def command(root, canary, args, fixture_root)
  expanded = args.map { |arg| arg.gsub("ROOT", fixture_root) }
  [ RbConfig.ruby, File.join(root, canary[:script]), *expanded ]
end

failures = 0
canaries.each do |canary|
  next if canary[:bad].nil?
  bad_root = File.join(root, canary[:bad])
  legal_root = File.join(root, canary[:legal])
  abort "enforcement_canaries: missing bad fixture #{bad_root}" unless Dir.exist?(bad_root)
  abort "enforcement_canaries: missing legal fixture #{legal_root}" unless Dir.exist?(legal_root)

  output, status = Open3.capture2e(*command(root, canary, canary[:bad_args], bad_root))
  if status.exitstatus != 1 || !output.include?(canary[:expected])
    warn "canary #{canary[:name]}: expected failure containing #{canary[:expected].inspect}"
    warn output
    failures += 1
  end

  output, status = Open3.capture2e(*command(root, canary, canary[:legal_args], legal_root))
  unless status.success?
    warn "canary #{canary[:name]}: legal counterpart failed"
    warn output
    failures += 1
  end
end

warn "enforcement_canaries: checked #{canaries.length} canaries; failures=#{failures}"
exit(failures.zero? ? 0 : 1)
