#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "optparse"

root = Dir.pwd
OptionParser.new do |parser|
  parser.banner = "Usage: script/ci/enforcement_canaries [--root DIR]"
  parser.on("--root DIR") { |value| root = value }
end.parse!

