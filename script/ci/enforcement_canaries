#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "open3"
require "optparse"

require_relative "eslint/canary_cases"
require_relative "eslint/support"

root = Dir.pwd
OptionParser.new do |parser|
  parser.banner = "Usage: script/ci/enforcement_canaries [--root DIR]"
  parser.on("--root DIR") { |value| root = value }
end.parse!

root = File.expand_path(root)
abort "enforcement_canaries: root does not exist: #{root}" unless Dir.exist?(root)

REQUIRED_CHECKS = %w[affected pins actions_pinned workflow_policy skips test_selectors frontend_boundary page_props].freeze
REQUIRED_CANARIES = %w[design_system_api_canary].freeze

config_path = File.join(root, "config", "ci.rb")
abort "enforcement_canaries: config/ci.rb is missing" unless File.file?(config_path)

config_ci = File.read(config_path)
step_scripts = config_ci.lines.filter_map do |line|
  line[/^\s*step\s+.*?"script\/ci\/([^"]+)"/, 1]&.split&.first
end.uniq
abort "enforcement_canaries: config/ci.rb has no script/ci steps" if step_scripts.empty?
step_scripts.each do |name|
  path = File.join(root, "script", "ci", name)
  abort "enforcement_canaries: config/ci.rb names missing script/ci/#{name}" unless File.file?(path)
end

missing_canaries = REQUIRED_CANARIES - step_scripts
unless missing_canaries.empty?
  abort "enforcement_canaries: config/ci.rb does not run #{missing_canaries.join(', ')}"
end

# Rafelo cops: discovered from the cops directory.
cop_names = Dir[File.join(root, "script", "ci", "cops", "rafelo", "*.rb")]
            .reject { |path| File.basename(path, ".rb") == "matching" }
            .map { |path| "Rafelo/#{File.basename(path, ".rb").split("_").map(&:capitalize).join}" }
            .sort
abort "enforcement_canaries: no Rafelo cops in script/ci/cops/rafelo" if cop_names.empty?

# Bypass fixtures (TS-07): every cop has one, next to its canary; the counts
# are proven by `script/ci/cops_canary` (syntax-only matching, exact counts).
def bypass_snake(cop)
  cop.delete_prefix("Rafelo/").gsub(/[A-Z]/) { |letter| "_#{letter.downcase}" }.sub(/\A_/, "").downcase
end

cop_names.each do |cop|
  unless Dir[File.join(root, "spec", "enforcement", "fixtures", "cops", "bypass", "**", "#{bypass_snake(cop)}.rb")].any?
    abort "enforcement_canaries: no bypass fixture for #{cop}"
  end
end

# dependency-cruiser rules: discovered from .dependency-cruiser.cjs.
depcruise_rules = File.read(File.join(root, ".dependency-cruiser.cjs"))
                   .scan(/^\s+name: "([^"]+)"/).flatten.sort

# ESLint: discovered by printing the config at the real paths the shared canary
# table names: the local plugin rules (rafelo/*) and the restriction rules.
eslint = Rafelo::ESLint.binary(root)
abort "enforcement_canaries: eslint is not installed at #{eslint}" unless File.executable?(eslint)

eslint_paths = Rafelo::ESLintCanary.print_config(root).map { |test| test[:path] }.uniq
eslint_rules = Rafelo::ESLint.enforcement_rule_names(root, eslint_paths)
abort "enforcement_canaries: the local ESLint plugin exports no rules" if eslint_rules.empty?

