#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "yaml"

require_relative "approvals"
require_relative "ratchet_counts"

root = Dir.pwd
base = ENV["BASE_SHA"]
reviews_file = nil
pr = ENV["PR_NUMBER"]
head_ref = ENV["HEAD_REF"]
repository = ENV["GITHUB_REPOSITORY"]
author = ENV["PR_AUTHOR"]
update = false
clones = true

OptionParser.new do |parser|
  parser.banner = "Usage: script/ci/ratchet [--root DIR] [--base REV] [--reviews FILE] [--pr NUMBER] [--update] [--no-clones]"
  parser.on("--root DIR") { |value| root = value }
  parser.on("--base REV") { |value| base = value }
  parser.on("--reviews FILE") { |value| reviews_file = value }
  parser.on("--pr NUMBER") { |value| pr = value }
  parser.on("--update") { update = true }
  parser.on("--no-clones") { clones = false }
end.parse!

root = File.expand_path(root)
abort "ratchet: root does not exist: #{root}" unless Dir.exist?(root)

# Each product module and domain engine keeps every count where its code
# lives; the root file holds the kernel/app counts and the clone baseline.
# The kernel engines are covered by the root file (ARCH-11, ARCH-12).
REQUIRED_ROOT_KEYS = %w[
  eslint_disable rubocop_disable use_no_memo skipped_tests
  clone_baseline_entries legacy_lint_paths clone_min_tokens
].freeze
REQUIRED_ENGINE_KEYS = %w[
  eslint_disable rubocop_disable use_no_memo skipped_tests
  page_budget_overrides legacy_table_prefixes legacy_constants
].freeze
KERNEL_ENGINES = %w[core design_system].freeze

def required_engine_files(root)
  Dir[File.join(root, "engines", "*")].select { |dir| File.directory?(dir) }
    .reject { |dir| KERNEL_ENGINES.include?(File.basename(dir)) }
    .map { |dir| "engines/#{File.basename(dir)}/config/ratchets.yml" }
    .sort
end

def ratchet_files(root)
  [ "config/ratchets.yml" ] + required_engine_files(root).select do |file|
    File.file?(File.join(root, file))
  end
end

def validate_base!(root, base)
  _output, status = Open3.capture2(
    "git", "-C", root, "rev-parse", "--verify", "#{base}^{commit}", err: File::NULL
  )
  abort "ratchet: invalid base #{base}" unless status.success?
end

def load_ratchets(root, revision, file)
  listing, listing_status = Open3.capture2(
    "git", "-C", root, "ls-tree", "--name-only", revision, "--", file, err: File::NULL
  )
  abort "ratchet: cannot list #{file} at #{revision}" unless listing_status.success?
  return {} if listing.strip.empty?

  output, status = Open3.capture2("git", "-C", root, "show", "#{revision}:#{file}", err: File::NULL)
  abort "ratchet: cannot read #{file} at #{revision}" unless status.success?

  YAML.safe_load(output) || {}
end

def validate_keys!(root, file, required)
  path = File.join(root, file)
  abort "ratchet: #{file} is missing" unless File.file?(path)

  data = YAML.safe_load_file(path) || {}
  missing = required - data.keys
  abort "ratchet: #{file} is missing #{missing.join(", ")}" unless missing.empty?

  invalid = required.reject { |key| data[key].is_a?(Integer) }
  abort "ratchet: #{file} has non-integer values for #{invalid.join(", ")}" unless invalid.empty?
end

missing_engines = required_engine_files(root).reject { |file| File.file?(File.join(root, file)) }
unless missing_engines.empty?
  abort "ratchet: every engine needs a ratchets file: missing #{missing_engines.join(", ")}"
end

files = ratchet_files(root)
abort "ratchet: no ratchet file was found" if files.empty?

files.each do |file|
  validate_keys!(root, file, file == "config/ratchets.yml" ? REQUIRED_ROOT_KEYS : REQUIRED_ENGINE_KEYS)
end

if update
  rises = []
  updates = []
  files.each do |file|
    path = File.join(root, file)
    current = YAML.safe_load_file(path) || {}
    RatchetCounts.for(root, file, clones: clones).each do |key, value|
      next unless current[key].is_a?(Integer) && value.is_a?(Integer)

      if value > current[key]
        rises << [ file, key, current[key], value ]
      elsif value < current[key]
        updates << [ file, key, current[key], value ]
      end
    end
  end

  rises.each { |file, key, previous, value| warn "ratchet: #{file}:#{key} is above its ceiling (#{previous} < #{value}); an owner must approve the rise" }

  updates.each do |file, key, previous, value|
    path = File.join(root, file)
    text = File.read(path)
    text.sub!(/^#{Regexp.escape(key)}:\s*\d+/, "#{key}: #{value}") || abort("ratchet: cannot rewrite #{file}:#{key}")
    File.write(path, text)
    puts "ratchet: #{file}:#{key} #{previous} -> #{value}"
  end
  puts "ratchet: updated #{updates.size} count(s); rises=#{rises.size} need an owner"
  exit 0
end

abort "ratchet: --base or BASE_SHA is required" if base.to_s.empty?
validate_base!(root, base)

current = {}
base_counts = {}

files.each do |file|
  path = File.join(root, file)
  (YAML.safe_load_file(path) || {}).each do |key, value|
    current["#{file}:#{key}"] = value if value.is_a?(Integer)
  end
  load_ratchets(root, base, file).each do |key, value|
    base_counts["#{file}:#{key}"] = value if value.is_a?(Integer)
  end
end

# Count the real values in check mode: a value above its committed ceiling
# fails even when the YAML file was not edited. A new key required by the
# check set is recorded at its real value, not treated as a rise.
over = 0
files.each do |file|
  path = File.join(root, file)
  committed = YAML.safe_load_file(path) || {}
  RatchetCounts.for(root, file, clones: clones).each do |key, value|
    ceiling = committed[key]
    next unless ceiling.is_a?(Integer) && value.is_a?(Integer)
    next unless value > ceiling

    warn "ratchet: #{file}:#{key} is #{value}, above its ceiling #{ceiling}"
    over += 1
  end
end
if over.positive?
  warn "ratchet: #{over} real count(s) above their ceilings"
  exit 1
end

rises = current.filter_map do |key, value|
  previous = base_counts[key]
  next unless previous.is_a?(Integer)

  [ key, previous, value ] if value > previous
end
falls = current.filter_map do |key, value|
  next unless base_counts[key].is_a?(Integer)

  [ key, base_counts[key], value ] if value < base_counts[key]
end

if rises.empty?
  puts "ratchet: checked #{current.size} counters; rises=0 falls=#{falls.size}"
  exit 0
end

number = Approvals.pull_request_number(pr, head_ref)
if author.to_s.strip.empty? && number
  # merge_group has no pull request payload; resolve the author from the PR
  # number in head_ref before counting an approval (WF-03).
  author = Approvals.pull_request_author(repository: repository, number: number)
end
reviews = Approvals.reviews(file: reviews_file, pr: number, repository: repository)
unless Approvals.approved_by_owner?(Approvals.codeowners(root, base: base), reviews, author: author)
  rises.each { |key, previous, value| warn "ratchet: #{key} rose from #{previous} to #{value}" }
  warn "ratchet: a rise needs an approval from a CODEOWNERS owner other than the pull request author"
  exit 1
end

puts "ratchet: checked #{current.size} counters; rises=#{rises.size} approved, falls=#{falls.size}"
