# CRLF keeps the line number of the real @apply.
Dir.mktmpdir("rafelo-apply-") do |dir|
  git(dir, "init", "-q")
  FileUtils.mkdir_p(File.join(dir, "app", "frontend", "styles"))
  File.binwrite(File.join(dir, "app", "frontend", "styles", "application.css"),
                ".x { background: url(a/*b); }\r\n.y { @apply flex; }\r\n")
  git(dir, "add", "-A")
  cases += 1
  output, status = run(script, dir)
  unless status.exitstatus == 1 && output.include?("app/frontend/styles/application.css:2") &&
         !output.include?("app/frontend/styles/application.css:1:")
    failures += 1
    warn "apply_check_canary: CRLF url and at-rule: #{status.exitstatus}: #{output}"
  end
