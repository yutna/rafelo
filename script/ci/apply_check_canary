#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "open3"
require "tmpdir"

root = File.expand_path("../..", __dir__)
script = File.join(root, "script", "ci", "apply_check")

def run(script, root)
  Open3.capture2e(script, "--root", root)
end

def git(dir, *args)
  output, status = Open3.capture2e("git", "-C", dir, *args)
  abort "apply_check_canary: git #{args.join(' ')} failed: #{output}" unless status.success?
end

failures = 0
cases = 0

Dir.mktmpdir("rafelo-apply-") do |dir|
  git(dir, "init", "-q")
  cases += 1
  output, status = run(script, dir)
  unless status.exitstatus == 1 && output.include?("no CSS files found") && output.include?("checked 0")
    failures += 1
    warn "apply_check_canary: empty root: #{status.exitstatus}: #{output}"
  end
end

Dir.mktmpdir("rafelo-apply-") do |dir|
  git(dir, "init", "-q")
  FileUtils.mkdir_p(File.join(dir, "app", "frontend", "styles"))
  FileUtils.mkdir_p(File.join(dir, "engines", "design_system", "app", "frontend"))
  File.write(File.join(dir, "app", "frontend", "styles", "application.css"), "body { margin: 0; }\n")
  File.write(File.join(dir, "engines", "design_system", "app", "frontend", "theme.css"),
             "/* @apply is allowed here */\n.button { @apply rounded; }\n")
  git(dir, "add", "-A")
  cases += 1
  output, status = run(script, dir)
  unless status.success? && output.include?("checked 2 CSS files")
    failures += 1
    warn "apply_check_canary: legal @apply: #{status.exitstatus}: #{output}"
  end
end

Dir.mktmpdir("rafelo-apply-") do |dir|
  git(dir, "init", "-q")
  FileUtils.mkdir_p(File.join(dir, "app", "frontend", "styles"))
  File.write(File.join(dir, "app", "frontend", "styles", "application.css"),
             ".button { margin: 0; }\n/* use @apply here */\n.button { @apply rounded; }\n")
  git(dir, "add", "-A")
  cases += 1
  output, status = run(script, dir)
  unless status.exitstatus == 1 && output.include?("app/frontend/styles/application.css:3") &&
         !output.include?("app/frontend/styles/application.css:2:") &&
         output.include?("apply-outside-design-system")
    failures += 1
    warn "apply_check_canary: comment and at-rule: #{status.exitstatus}: #{output}"
  end
end

Dir.mktmpdir("rafelo-apply-") do |dir|
  git(dir, "init", "-q")
  FileUtils.mkdir_p(File.join(dir, "app", "frontend", "styles"))
  File.write(File.join(dir, "app", "frontend", "styles", "application.css"),
             "/* use @apply here */\n")
  git(dir, "add", "-A")
  cases += 1
  output, status = run(script, dir)
  unless status.success? && output.include?("checked 1 CSS files; findings=0")
    failures += 1
    warn "apply_check_canary: comment only: #{status.exitstatus}: #{output}"
  end
end

# A `/*` inside an unquoted url() is data, not a comment: a real @apply after
# it must still be reported (FE-06).
Dir.mktmpdir("rafelo-apply-") do |dir|
  git(dir, "init", "-q")
  FileUtils.mkdir_p(File.join(dir, "app", "frontend", "styles"))
  File.write(File.join(dir, "app", "frontend", "styles", "application.css"),
             ".x { background: url(a/*b); }\n.y { @apply flex; }\n")
  git(dir, "add", "-A")
  cases += 1
  output, status = run(script, dir)
  unless status.exitstatus == 1 && output.include?("app/frontend/styles/application.css:2") &&
         !output.include?("app/frontend/styles/application.css:1:")
    failures += 1
    warn "apply_check_canary: url and at-rule: #{status.exitstatus}: #{output}"
  end
end

# The same inside a quoted url().
Dir.mktmpdir("rafelo-apply-") do |dir|
  git(dir, "init", "-q")
  FileUtils.mkdir_p(File.join(dir, "app", "frontend", "styles"))
  File.write(File.join(dir, "app", "frontend", "styles", "application.css"),
             ".x { background: url(\"a/*b\"); }\n.y { @apply flex; }\n")
  git(dir, "add", "-A")
  cases += 1
  output, status = run(script, dir)
  unless status.exitstatus == 1 && output.include?("app/frontend/styles/application.css:2") &&
         !output.include?("app/frontend/styles/application.css:1:")
    failures += 1
    warn "apply_check_canary: quoted url and at-rule: #{status.exitstatus}: #{output}"
  end
end

if failures.positive?
  warn "apply_check_canary: checked #{cases} cases; failures=#{failures}"
  exit 1
end

warn "apply_check_canary: checked #{cases} cases; failures=0"
