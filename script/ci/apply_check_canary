# A CSS escape in the function name still decodes to url(): `u\72l(` is url(.
Dir.mktmpdir("rafelo-apply-") do |dir|
  git(dir, "init", "-q")
  FileUtils.mkdir_p(File.join(dir, "app", "frontend", "styles"))
  File.write(File.join(dir, "app", "frontend", "styles", "application.css"),
             ".x { background: u\\72l(a/*b); }\n.y { @apply flex; }\n")
  git(dir, "add", "-A")
  cases += 1
  output, status = run(script, dir)
  unless status.exitstatus == 1 && output.include?("app/frontend/styles/application.css:2") &&
         !output.include?("app/frontend/styles/application.css:1:")
    failures += 1
    warn "apply_check_canary: escaped url and at-rule: #{status.exitstatus}: #{output}"
  end
end

# One whitespace after a hex escape belongs to the escape; a space, a CRLF,
# and a form feed (preprocessed to a newline by CSS) all terminate it, and the
# name continues with `l`.
[ [ "escaped url space", ".x { background: u\\72 l(a/*b); }\n.y { @apply flex; }\n", 2 ],
  [ "escaped url CRLF", ".x { background: u\\72\r\nl(a/*b); }\r\n.y { @apply flex; }\r\n", 3 ],
  [ "escaped url form feed", ".x { background: u\\" + "\f" + "rl(a/*b); }\n.y { @apply flex; }\n", 2 ] ].each do |name, css, line|
  Dir.mktmpdir("rafelo-apply-") do |dir|
    git(dir, "init", "-q")
    FileUtils.mkdir_p(File.join(dir, "app", "frontend", "styles"))
    File.binwrite(File.join(dir, "app", "frontend", "styles", "application.css"), css)
    git(dir, "add", "-A")
    cases += 1
    output, status = run(script, dir)
    expected = "app/frontend/styles/application.css:#{line}"
    unless status.exitstatus == 1 && output.include?(expected)
      failures += 1
      warn "apply_check_canary: #{name}: #{status.exitstatus}: #{output}"
    end
  end
end

