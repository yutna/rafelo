#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "open3"
require "tmpdir"
require "timeout"

root = File.expand_path("../..", __dir__)
script = File.join(root, "script", "ci", "apply_check")

def run(script, root)
  Open3.capture2e(script, "--root", root)
end

# A stuck guard must not outlive the canary; kill it on timeout.
def run_with_timeout(script, root, seconds)
  output = +""
  Open3.popen2e(script, "--root", root) do |stdin, stdout, wait|
    stdin.close
    begin
      Timeout.timeout(seconds) { output << stdout.read }
    rescue Timeout::Error
      Process.kill("TERM", wait.pid)
      wait.value
      return [ output, nil ]
    end
    [ output, wait.value ]
  end
end

def git(dir, *args)
  output, status = Open3.capture2e("git", "-C", dir, *args)
  abort "apply_check_canary: git #{args.join(' ')} failed: #{output}" unless status.success?
end

failures = 0
cases = 0

Dir.mktmpdir("rafelo-apply-") do |dir|
  git(dir, "init", "-q")
  cases += 1
  output, status = run(script, dir)
  unless status.exitstatus == 1 && output.include?("no CSS files found") && output.include?("checked 0")
    failures += 1
    warn "apply_check_canary: empty root: #{status.exitstatus}: #{output}"
  end
end

