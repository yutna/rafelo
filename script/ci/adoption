#!/usr/bin/env bash
# script/ci/adoption
#
# The template's own CI proof (GEN-07): adopt the commit under test under a
# two-word name, run the gate, then adopt release N-1, update it to N with
# bin/kernel_update, and run the gate again.
set -euo pipefail

repo="$(cd "$(dirname "$0")/../.." && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

ruby_bin="$(cd "$repo" && ruby -e 'puts RbConfig.ruby')"
rails_bin="$(cd "$repo" && bundle exec ruby -e 'puts Gem.bin_path("railties", "rails")')"

version="${ADOPTION_VERSION:-$(cat "$repo/VERSION")}"
IFS=. read -r major minor patch <<< "$version"
if [ "$patch" -gt 0 ]; then
  base_version="${major}.${minor}.$((patch - 1))"
else
  base_version="${major}.$((minor - 1)).0"
fi
base_tag="v${base_version}"

archive() {
  local revision="$1" destination="$2"
  mkdir -p "$destination"
  git -C "$repo" archive "$revision" | tar -x -C "$destination"
}

adopt() {
  local source="$1" destination="$2" template="$3"
  ( cd "$work" && BUNDLE_GEMFILE="$repo/Gemfile" RUBYOPT=-rbundler/setup \
      "$ruby_bin" "$rails_bin" new "$destination" \
      -d postgresql --devcontainer \
      --skip-javascript --skip-hotwire --skip-jbuilder --skip-test \
      --skip-bundle -m "$template" )
}

clean_tree() {
  local app="$1"
  git -C "$app" status --porcelain --untracked-files=all
}

check_no_placeholder() {
  local app="$1"
  local found
  found="$(git -C "$app" ls-files | grep -i 'acme' || true)"
  if [ -n "$found" ]; then
    echo "adoption: placeholder path in $app: $found" >&2
    exit 1
  fi
  if git -C "$app" grep -Iil 'acme' -- . >/dev/null 2>&1; then
    echo "adoption: placeholder text in $app" >&2
    git -C "$app" grep -Iil 'acme' -- . >&2
    exit 1
  fi
}

gate() {
  local app="$1"
  ( cd "$app" && bin/setup --skip-server )
  ( cd "$app" && BASE_SHA="$(git rev-list --max-parents=0 HEAD)" bin/ci )
  check_no_placeholder "$app"
  test -z "$(clean_tree "$app")"
}

echo "adoption: packing HEAD and adopting smoke_shop"
archive HEAD "$work/current-src"
if [ "$version" != "$(cat "$repo/VERSION")" ]; then
  # The release-under-test version can be ahead of the committed VERSION while
  # a release pull request is in review.
  cp -a "$work/current-src" "$work/target-src"
  printf '%s\n' "$version" > "$work/target-src/VERSION"
  current_src="$work/target-src"
else
  current_src="$work/current-src"
fi
adopt "$current_src" "$work/smoke_shop" "$current_src/template/template.rb"
gate "$work/smoke_shop"

if ! git -C "$repo" rev-parse -q --verify "refs/tags/$base_tag" >/dev/null; then
  echo "adoption: $base_tag is missing; fetch the release tags" >&2
  exit 1
fi
if ! git -C "$repo" cat-file -e "$base_tag:template/template.rb" 2>/dev/null &&
   ! git -C "$repo" cat-file -e "$base_tag:docs/contracts.md" 2>/dev/null; then
  echo "adoption: $base_tag predates the template payload; the N-1 update proof starts with v0.20.0"
  exit 0
fi

echo "adoption: adopting release $base_tag and updating it to $version"
archive "$base_tag" "$work/base-src"
if [ ! -f "$work/base-src/template/template.rb" ]; then
  # v0.20.0 has the payload's documentation and scripts but no template yet;
  # adopt its kernel with the template under test, then prove the update path.
  cp -a "$current_src/template" "$work/base-src/template"
fi
adopt "$work/base-src" "$work/smoke_shop_prev" "$work/base-src/template/template.rb"
# Run the updater under test. The N-1 fixture ships the previous updater, and
# an update that adds root tooling (ESLint/Prettier) is exactly what this gate
# must exercise; the release's updater is the documented path for that.
cp "$current_src/bin/kernel_update" "$work/smoke_shop_prev/bin/kernel_update"
cp "$current_src/script/ci/kernel_update" "$work/smoke_shop_prev/script/ci/kernel_update"
( cd "$work/smoke_shop_prev" && bin/kernel_update "$version" \
    --base-source "$work/base-src" --source "$current_src" \
    --include design_system/app/frontend )
# The N-1 fixture is a generated app with no dependency changes of its own.
# Bring its app-owned Gemfile and lockfile to the release under test, as an
# adopter does when resolving the stack again (00_README.md step 5), so the
# update proof tests the kernel merge instead of an old release's advisories.
# The composition root is also app-owned, but a generated fixture has no
# customizations; render it with the fixture's namespace so a kernel change
# that depends on the new framework set is proven end to end. The app-owned
# sessions controller stays as released: AuthGateway's compatibility fallback
# keeps its v0.23.0 deadline-less budget working (B3). bin/kernel_update still
# leaves app-owned files alone (GEN-07).
cp "$current_src/Gemfile" "$current_src/Gemfile.lock" "$work/smoke_shop_prev/"
"$ruby_bin" -r"$current_src/template/lib/rafelo_template" -e '
  source, target, app_name = ARGV
  text = File.read(source)
  File.write(target, RafeloTemplate.render_text(text, "app", app_name, RafeloTemplate.namespace(app_name)))
' "$current_src/config/application.rb" "$work/smoke_shop_prev/config/application.rb" smoke_shop_prev
# The example engines are app-owned after adoption (GEN-08). A newly stricter
# kernel check must not fail on the fixture's older copy; a generated fixture
# has no customizations, so refresh both examples too (same #403 reading). The
# design-system frontend comes from the release under test through the
# documented folder include (GEN-07); a real adopter requests it when it
# wants that component, and the refreshed examples use its test ids.
for example in example_customers example_orders; do
  rm -rf "$work/smoke_shop_prev/engines/$example"
  cp -R "$current_src/engines/$example" "$work/smoke_shop_prev/engines/$example"
done
# The generated fixture has no app-owned customizations either; keep its app
# and end-to-end code at the release under test so the new lint layer sees the
# updated files rather than the older release's formatting and imports.
for path in app/frontend e2e; do
  rm -rf "$work/smoke_shop_prev/$path"
  cp -R "$current_src/$path" "$work/smoke_shop_prev/$path"
  "$ruby_bin" -r"$current_src/template/lib/rafelo_template" -e '
    root, app_name = ARGV
    namespace = RafeloTemplate.namespace(app_name)
    Dir[File.join(root, "**/*")].each do |path|
      next unless File.file?(path)

      text = File.binread(path).force_encoding(Encoding::UTF_8)
      next unless text.valid_encoding?

      File.binwrite(path, RafeloTemplate.render_text(text, "app", app_name, namespace))
    end
  ' "$work/smoke_shop_prev/$path" smoke_shop_prev
done
rm -rf "$work/smoke_shop_prev/engines/design_system/e2e"
cp -R "$current_src/engines/design_system/e2e" "$work/smoke_shop_prev/engines/design_system/e2e"
( cd "$work/smoke_shop_prev" && BUNDLE_FROZEN=false bundle install >/dev/null )
# A generated fixture has no customizations; apply the release's format step
# to the refreshed app-owned docs and files before the gate.
( cd "$work/smoke_shop_prev" && bin/setup --skip-server >/dev/null && npm run format >/dev/null )
( cd "$work/smoke_shop_prev" && git add -A && \
    git -c user.name="Rafelo CI" -c user.email="ci@rafelo.invalid" -c commit.gpgsign=false \
      commit -q -m "chore: update the kernel to v$version" )
gate "$work/smoke_shop_prev"

echo "adoption: smoke_shop and the $base_tag to $version update passed"
