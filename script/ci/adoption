#!/usr/bin/env bash
# script/ci/adoption
#
# The template's own CI proof (GEN-07): adopt the commit under test under a
# two-word name, run the gate, then adopt release N-1, update it to N with
# bin/kernel_update, and run the gate again.
set -euo pipefail

repo="$(cd "$(dirname "$0")/../.." && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

ruby_bin="$(cd "$repo" && ruby -e 'puts RbConfig.ruby')"
rails_bin="$(cd "$repo" && bundle exec ruby -e 'puts Gem.bin_path("railties", "rails")')"

version="${ADOPTION_VERSION:-$(cat "$repo/VERSION")}"
IFS=. read -r major minor patch <<< "$version"
if [ "$patch" -gt 0 ]; then
  base_version="${major}.${minor}.$((patch - 1))"
else
  base_version="${major}.$((minor - 1)).0"
fi
base_tag="v${base_version}"

archive() {
  local revision="$1" destination="$2"
  mkdir -p "$destination"
  git -C "$repo" archive "$revision" | tar -x -C "$destination"
}

adopt() {
  local source="$1" destination="$2" template="$3"
  ( cd "$work" && BUNDLE_GEMFILE="$repo/Gemfile" RUBYOPT=-rbundler/setup \
      "$ruby_bin" "$rails_bin" new "$destination" \
      -d postgresql --devcontainer \
      --skip-javascript --skip-hotwire --skip-jbuilder --skip-test \
      --skip-bundle -m "$template" )
}

clean_tree() {
  local app="$1"
  git -C "$app" status --porcelain --untracked-files=all
}

check_no_placeholder() {
  local app="$1"
  local found
  found="$(git -C "$app" ls-files | grep -i 'acme' || true)"
  if [ -n "$found" ]; then
    echo "adoption: placeholder path in $app: $found" >&2
    exit 1
  fi
  if git -C "$app" grep -Iil 'acme' -- . >/dev/null 2>&1; then
    echo "adoption: placeholder text in $app" >&2
    git -C "$app" grep -Iil 'acme' -- . >&2
    exit 1
  fi
}

gate() {
  local app="$1"
  ( cd "$app" && bin/setup --skip-server )
  ( cd "$app" && BASE_SHA="$(git rev-list --max-parents=0 HEAD)" bin/ci )
  check_no_placeholder "$app"
  test -z "$(clean_tree "$app")"
}

echo "adoption: packing HEAD and adopting smoke_shop"
archive HEAD "$work/current-src"
if [ "$version" != "$(cat "$repo/VERSION")" ]; then
  # The release-under-test version can be ahead of the committed VERSION while
  # a release pull request is in review.
  cp -a "$work/current-src" "$work/target-src"
  printf '%s\n' "$version" > "$work/target-src/VERSION"
  current_src="$work/target-src"
else
  current_src="$work/current-src"
fi
adopt "$current_src" "$work/smoke_shop" "$current_src/template/template.rb"
gate "$work/smoke_shop"

if ! git -C "$repo" cat-file -e "$base_tag:template/template.rb" 2>/dev/null &&
   ! git -C "$repo" cat-file -e "$base_tag:docs/contracts.md" 2>/dev/null; then
  echo "adoption: $base_tag predates the template payload; the N-1 update proof starts with v0.20.0"
  exit 0
fi

echo "adoption: adopting release $base_tag and updating it to $version"
archive "$base_tag" "$work/base-src"
if [ ! -f "$work/base-src/template/template.rb" ]; then
  # v0.20.0 has the payload's documentation and scripts but no template yet;
  # adopt its kernel with the template under test, then prove the update path.
  cp -a "$current_src/template" "$work/base-src/template"
fi
adopt "$work/base-src" "$work/smoke_shop_prev" "$work/base-src/template/template.rb"
if [ ! -f "$work/smoke_shop_prev/bin/kernel_update" ]; then
  cp "$current_src/bin/kernel_update" "$work/smoke_shop_prev/bin/kernel_update"
  cp "$current_src/script/ci/kernel_update" "$work/smoke_shop_prev/script/ci/kernel_update"
fi
( cd "$work/smoke_shop_prev" && bin/kernel_update "$version" \
    --base-source "$work/base-src" --source "$current_src" )
( cd "$work/smoke_shop_prev" && git add -A && git commit -q -m "chore: update the kernel to v$version" )
gate "$work/smoke_shop_prev"

echo "adoption: smoke_shop and the $base_tag to $version update passed"
