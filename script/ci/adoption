#!/usr/bin/env bash
# script/ci/adoption
#
# The template's own CI proof (GEN-07): adopt the commit under test under a
# two-word name and run the gate, and/or adopt release N-1, update it to N with
# bin/kernel_update, and run the gate again. The workflow decides which proof
# runs; pass "current", "update", or "all" (the default) as the first argument.
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

ruby_bin="$(cd "$repo" && ruby -e 'puts RbConfig.ruby')"
rails_bin="$(cd "$repo" && bundle exec ruby -e 'puts Gem.bin_path("railties", "rails")')"

version="${ADOPTION_VERSION:-$(cat "$repo/VERSION")}"
IFS=. read -r major minor patch <<< "$version"
if [ "$patch" -gt 0 ]; then
  base_version="${major}.${minor}.$((patch - 1))"
else
  base_version="${major}.$((minor - 1)).0"
fi
base_tag="v${base_version}"

archive() {
  local revision="$1" destination="$2"
  mkdir -p "$destination"
  git -C "$repo" archive "$revision" | tar -x -C "$destination"
}

adopt() {
  local source="$1" destination="$2" template="$3"
  # The documented command, in the same order: no --skip-bundle, and the
  # template already owns what the kamal and solid installs would rewrite.
  ( cd "$work" \
      && "$ruby_bin" "$rails_bin" new "$destination" \
        -d postgresql --devcontainer \
        --skip-javascript --skip-hotwire --skip-jbuilder --skip-kamal \
        --skip-solid --skip-test -m "$template" )
}

assert_template_commit_clean() {
  local app="$1"
  local dirty
  if ! dirty="$(clean_tree "$app")"; then
    exit 1
  fi
  if [ -z "$dirty" ]; then return; fi

  echo "adoption: rails new changed the template's initial commit in $app:" >&2
  printf '%s\n' "$dirty" >&2
  exit 1
}

clean_tree() {
  local app="$1"
  local output
  if ! output="$(git -C "$app" status --porcelain --untracked-files=all)"; then
    echo "adoption: cannot read the working tree in $app" >&2
    return 1
  fi
  printf '%s\n' "$output"
}

tracked_files() {
  local app="$1"
  local output
  if ! output="$(git -C "$app" ls-files)"; then
    echo "adoption: cannot list tracked files in $app" >&2
    exit 1
  fi
  printf '%s\n' "$output"
}

git_matches() {
  local app="$1"
  local pattern="$2"
  shift 2
  local output status
  # git grep exits 1 for no match and 2+ for an error. Return a distinct status
  # instead of exiting: the caller runs this in a command substitution, where
  # exit would only leave the subshell and look like "no match". Keep the
  # caller's `set -e` state unchanged.
  if output="$(git -C "$app" grep -IilE "$pattern" -- "$@" 2>&1)"; then
    status=0
  else
    status=$?
  fi
  if [ "$status" -gt 1 ]; then
    echo "adoption: cannot search $app: $output" >&2
    return 2
  fi
  if [ -n "$output" ]; then
    printf '%s\n' "$output"
  fi
  return "$status"
}

check_no_placeholder() {
  local app="$1"
  local scope="${2:-all}"
  local files
  local found
  local status
  local brand="Rafelo"
  local lower="rafelo"
  local paths=(.)
  if [ "$scope" = "examples" ]; then
    # The update proof checks the whole adopted app again. Only docs/architecture
    # is outside it: those files are app-owned, the updater does not carry them,
    # and a base release's prose may legitimately mention the examples.
    paths=(. ":(exclude)docs/architecture")
  fi
  files="$(tracked_files "$app")"
  found="$(printf '%s\n' "$files" | grep -i 'acme' || true)"
  if [ -n "$found" ]; then
    echo "adoption: placeholder path in $app: $found" >&2
    exit 1
  fi
  set +e
  found="$(git_matches "$app" 'acme' .)"
  status=$?
  set -e
  if [ "$status" -gt 1 ]; then
    exit 1
  fi
  if [ "$status" -eq 0 ]; then
    echo "adoption: placeholder text in $app" >&2
    printf '%s\n' "$found" >&2
    exit 1
  fi
  # The kernel brand stays, but an example engine never keeps a kernel Ruby
  # namespace or path after adoption (GEN-07, decision 1). The update proof
  # checks the whole app except the app-owned docs/architecture.
  set +e
  found="$(git_matches "$app" "${brand}::Example|${lower}/example_|${lower}_example_" "${paths[@]}")"
  status=$?
  set -e
  if [ "$status" -gt 1 ]; then
    exit 1
  fi
  if [ "$status" -eq 0 ]; then
    echo "adoption: example engine kept the kernel namespace in $app" >&2
    printf '%s\n' "$found" >&2
    exit 1
  fi
}

gate() {
  local app="$1"
  local scope="${2:-all}"
  local dirty
  ( cd "$app" && BUNDLE_FROZEN=false bin/setup --skip-server )
  ( cd "$app" && BUNDLE_FROZEN=false BASE_SHA="$(git rev-list --max-parents=0 HEAD)" bin/ci )
  check_no_placeholder "$app" "$scope"
  if ! dirty="$(clean_tree "$app")"; then
    exit 1
  fi
  if [ -n "$dirty" ]; then
    echo "adoption: $app has uncommitted changes after the gate:" >&2
    printf '%s\n' "$dirty" >&2
    exit 1
  fi
}

prepare_sources() {
  echo "adoption: packing HEAD"
  archive HEAD "$work/current-src"
  if [ "$version" != "$(cat "$repo/VERSION")" ]; then
    # The release-under-test version can be ahead of the committed VERSION while
    # a release pull request is in review.
    cp -a "$work/current-src" "$work/target-src"
    printf '%s\n' "$version" > "$work/target-src/VERSION"
    current_src="$work/target-src"
  else
    current_src="$work/current-src"
  fi
}

run_current() {
  echo "adoption: adopting the commit under test"
  adopt "$current_src" "$work/smoke_shop" "$current_src/template/template.rb"
  assert_template_commit_clean "$work/smoke_shop"
  gate "$work/smoke_shop"
  echo "adoption: the commit under test adopted and passed"
}

run_update() {
  if ! git -C "$repo" rev-parse -q --verify "refs/tags/$base_tag" >/dev/null; then
    echo "adoption: $base_tag is missing; fetch the release tags" >&2
    exit 1
  fi
  if ! git -C "$repo" cat-file -e "$base_tag:template/template.rb" 2>/dev/null &&
     ! git -C "$repo" cat-file -e "$base_tag:docs/contracts.md" 2>/dev/null; then
    echo "adoption: $base_tag predates the template payload; the N-1 update proof starts with v0.20.0"
    return
  fi

  echo "adoption: adopting release $base_tag and updating it to $version"
  archive "$base_tag" "$work/base-src"
  if [ ! -f "$work/base-src/template/template.rb" ]; then
    # v0.20.0 has the payload's documentation and scripts but no template yet;
    # adopt its kernel with the template under test, then prove the update path.
    cp -a "$current_src/template" "$work/base-src/template"
  fi
  adopt "$work/base-src" "$work/smoke_shop_prev" "$work/base-src/template/template.rb"
  assert_template_commit_clean "$work/smoke_shop_prev"
  # v0.37 moved the synthetic grant catalog from the kernel fixture to the
  # app-owned config/grants.json. An N-1 adopter follows the migration note.
  if [ -f "$work/smoke_shop_prev/engines/core/spec/fixtures/upstream/api/grants.json" ] && \
     [ ! -f "$work/smoke_shop_prev/config/grants.json" ]; then
    cp "$work/smoke_shop_prev/engines/core/spec/fixtures/upstream/api/grants.json" \
      "$work/smoke_shop_prev/config/grants.json"
  fi
  # The N-1 generator's post-write steps run the app's npm scripts, so install
  # the app's toolchain before generating.
  ( cd "$work/smoke_shop_prev" && BUNDLE_FROZEN=false bin/setup --skip-server >/dev/null )
  # The generated-page leg (GEN-02, GEN-07): the N-1 generator writes a module
  # and a page slice before the update, so the gate proves that generated code
  # survives a kernel update. Never park this behind a version condition.
  ( cd "$work/smoke_shop_prev" && BUNDLE_FROZEN=false bin/rails generate rafelo:module legacy_check >/dev/null && \
      BUNDLE_FROZEN=false bin/rails generate rafelo:page legacy_check widgets --actions=index,new,edit >/dev/null )
  # The generated slice's permission keys belong to the app-owned grant catalog
  # (BE-03). The v0.37 generator syncs it; older N-1 generators need this merge.
  "$ruby_bin" -rjson -ryaml -e '
    root, module_name = ARGV
    grants_path = File.join(root, "config/grants.json")
    abort "adoption: #{grants_path} is missing" unless File.file?(grants_path)
    manifest = YAML.safe_load_file(File.join(root, "engines", module_name, "config/permissions.yml"), aliases: false) || {}
    grants = JSON.parse(File.read(grants_path)).fetch("grants")
    manifest.each do |prefix, resources|
      (resources || {}).each do |resource, actions|
        Array(actions).each { |action| grants << "#{prefix}:#{resource}:#{action}" }
      end
    end
    File.write(grants_path, JSON.pretty_generate("grants" => grants.uniq.sort) + "\n")
  ' "$work/smoke_shop_prev" legacy_check
  if [ ! -f "$work/smoke_shop_prev/bin/kernel_update" ]; then
    cp "$current_src/bin/kernel_update" "$work/smoke_shop_prev/bin/kernel_update"
    cp "$current_src/script/ci/kernel_update" "$work/smoke_shop_prev/script/ci/kernel_update"
  fi
  # The N-1 app runs its own updater first. That pass installs the release's
  # updater (script/ci and bin/kernel_update are kernel files), and the second
  # pass applies the new updater's default paths. This is the re-exec an updater
  # change needs, run explicitly so the fixture proves the N-1 command too.
  ( cd "$work/smoke_shop_prev" && bin/kernel_update "$version" \
      --base-source "$work/base-src" --source "$current_src" \
      --include design_system/app/frontend --include design_system/config/locales )
  # The new updater is now installed. Re-run it with the explicit base version
  # and the app-owned merge: a real adopter makes this second pass after seeing
  # that the updater changed, and --app-owned only updates files that still match
  # the base release (customized files stay untouched). No version rewind.
  ( cd "$work/smoke_shop_prev" && bin/kernel_update "$version" \
      --base-version "$base_version" --base-source "$work/base-src" --source "$current_src" \
      --include design_system/app/frontend --include design_system/config/locales \
      --app-owned --migrate-generated )
  # The N-1 fixture is a generated app with no dependency changes of its own.
  # Bring its app-owned Gemfile and lockfile to the release under test, as an
  # adopter does when resolving the stack again (00_README.md step 5), so the
  # update proof tests the kernel merge instead of an old release's advisories.
  # The composition root is app-owned too; the installed updater's second pass
  # updates it only when the fixture still matches the base (--app-owned), so no
  # harness copy is needed. The app-owned sessions controller stays as released:
  # AuthGateway's compatibility fallback keeps its v0.23.0 deadline-less budget
  # working (B3). bin/kernel_update leaves customized app-owned files alone
  # (GEN-07).
  cp "$current_src/Gemfile" "$current_src/Gemfile.lock" "$work/smoke_shop_prev/"
  cp "$current_src/.ruby-version" "$current_src/mise.toml" "$work/smoke_shop_prev/"
  # The example engines are app-owned after adoption (GEN-08). A newly stricter
  # kernel check must not fail on the fixture's older copy; a generated fixture
  # has no customizations, so refresh both examples too (same #403 reading). The
  # design-system frontend comes from the release under test through the
  # documented folder include (GEN-07); a real adopter requests it when it
  # wants that component, and the refreshed examples use its test ids.
  for example in example_customers example_orders; do
    rm -rf "$work/smoke_shop_prev/engines/$example"
  done
  "$ruby_bin" -r"$current_src/template/lib/rafelo_template.rb" -e \
    'RafeloTemplate.render_examples!(source_root: ARGV[0], destination: ARGV[1], app_name: ARGV[2], version: ARGV[3])' \
    "$current_src" "$work/smoke_shop_prev" "smoke_shop_prev" "$version"
  # Run the same setup the gate runs before committing, so the generated
  # engine's path gem and migration are in the committed tree. The extra
  # `bundle check` settles Bundler's path-source order; the first check after
  # adding an engine can pass while rewriting the lockfile, and the gate's own
  # check would then leave the tree dirty for the generator smoke.
  ( cd "$work/smoke_shop_prev" && BUNDLE_FROZEN=false bin/setup --skip-server >/dev/null && \
      BUNDLE_FROZEN=false bundle check >/dev/null )
  ( cd "$work/smoke_shop_prev" && git add -A && \
      git -c user.name="Rafelo CI" -c user.email="ci@rafelo.invalid" -c commit.gpgsign=false \
        commit -q -m "chore: update the kernel to v$version" )
  gate "$work/smoke_shop_prev" examples
  echo "adoption: $base_tag updated to $version and passed"
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  mode="${1:-all}"
  case "$mode" in
    current|update|all) ;;
    *)
      echo "adoption: unknown mode: $mode (use current, update, or all)" >&2
      exit 64
      ;;
  esac

  prepare_sources
  case "$mode" in
    current) run_current ;;
    update) run_update ;;
    all)
      run_current
      run_update
      ;;
  esac
fi
