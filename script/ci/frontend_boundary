#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"

root = Dir.pwd
OptionParser.new do |parser|
  parser.banner = "Usage: script/ci/frontend_boundary [--root DIR]"
  parser.on("--root DIR") { |value| root = value }
end.parse!

root = File.expand_path(root)
abort "frontend_boundary: root does not exist: #{root}" unless Dir.exist?(root)

patterns = %W[
  #{root}/app/frontend/**/*.ts
  #{root}/app/frontend/**/*.tsx
  #{root}/engines/*/app/frontend/**/*.ts
  #{root}/engines/*/app/frontend/**/*.tsx
]
files = patterns.flat_map { |pattern| Dir[pattern] }.uniq.select { |path| File.file?(path) }
abort "frontend_boundary: no frontend files found under #{root}" if files.empty?

findings = 0
files.each do |path|
  relative = path.delete_prefix("#{root}/")
  next if relative.include?("/layouts/") || relative == "app/frontend/entrypoints/application.tsx"

  File.readlines(path, chomp: true).each_with_index do |line, index|
    next unless line.match?(/\busePage\b/) && line.match?(/import|require/)

    puts "#{relative}:#{index + 1}: usePage is only allowed in layouts and the page resolver"
    findings += 1
  end
end

warn "frontend_boundary: checked #{files.length} files; findings=#{findings}"
exit(findings.zero? ? 0 : 1)
