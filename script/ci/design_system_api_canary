#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
button="$root/engines/design_system/app/frontend/button.tsx"
declarations="$root/engines/design_system/api.d.ts"
button_backup="$(mktemp)"
declarations_backup="$(mktemp)"
cp "$button" "$button_backup"
cp "$declarations" "$declarations_backup"
restore() {
  cp "$button_backup" "$button"
  cp "$declarations_backup" "$declarations"
}
cleanup() {
  rm -f "$button_backup" "$declarations_backup"
}
trap 'restore; cleanup' EXIT

sed -i 's/testId: string;/testId: number;/' "$button"
if (cd "$root" && npm run api:check >/dev/null 2>&1); then
  echo "design_system_api_canary: a changed public prop type passed" >&2
  exit 1
fi

restore
if ! (cd "$root" && npm run api:check >/dev/null 2>&1); then
  echo "design_system_api_canary: the restored API check failed" >&2
  exit 1
fi

# A syntactically broken declaration file must fail in the compile step, not
# only because it differs from the generated bytes.
printf '\nexport const broken: =;\n' >> "$declarations"
if output="$(cd "$root" && npm run api:check 2>&1)"; then
  echo "design_system_api_canary: a broken declaration passed" >&2
  exit 1
fi
if ! printf '%s\n' "$output" | grep -q 'error TS'; then
  echo "design_system_api_canary: a broken declaration failed for another reason" >&2
  printf '%s\n' "$output" >&2
  exit 1
fi

restore
trap - EXIT
cleanup
if ! (cd "$root" && npm run api:check >/dev/null 2>&1); then
  echo "design_system_api_canary: the restored API check failed after the compile case" >&2
  exit 1
fi

echo "design_system_api_canary: checked 3 cases"
