import { execFileSync } from "node:child_process";
import { readFileSync, readdirSync, rmSync, writeFileSync } from "node:fs";
import { dirname, join, relative, resolve } from "node:path";

const root = process.cwd();
const declarations = join(root, "tmp/tsc/design_system/app/frontend");

rmSync(join(root, "tmp/tsc/design_system"), { force: true, recursive: true });
rmSync(join(root, "tmp/tsc/design_system.tsbuildinfo"), { force: true });
execFileSync("npx", ["tsc", "-b", "engines/design_system/tsconfig.json", "--force"], {
  cwd: root,
  stdio: "inherit",
});

function walk(directory: string): string[] {
  return readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {
    const path = join(directory, entry.name);
    return entry.isDirectory() ? walk(path) : [path];
  });
}

function publicModule(file: string): string | null {
  const path = relative(declarations, file);
  if (!path.endsWith(".d.ts") || path.endsWith(".test.d.ts") || path.includes("internal/")) {
    return null;
  }

  const name = path.slice(0, -".d.ts".length).replace(/\/index$/, "");
  return `@design_system/${name}`;
}

const files = walk(declarations)
  .map((file) => ({ file, module: publicModule(file) }))
  .filter((entry): entry is { file: string; module: string } => entry.module !== null)
  .sort((left, right) => left.module.localeCompare(right.module));

const modules = new Set(files.map((entry) => entry.module));

function rewriteImports(source: string, file: string): string {
  return source.replace(/from "(\.\.?\/[^"]+)"/g, (match, specifier: string) => {
    const base = file.slice(0, -".d.ts".length);
    const target = resolve(dirname(base), specifier);
    const targetFile = target.endsWith(".d.ts") ? target : `${target}.d.ts`;
    const module = files.find((entry) => entry.file === targetFile)?.module;
    return module ? `from "${module}"` : match;
  });
}

function ambient(source: string): string {
  // A .d.ts file emitted by tsc uses `export declare` at the top level. That
  // modifier is invalid inside `declare module`; the module body is already
  // ambient (TS1038).
  return source.replace(/^(\s*)export declare /gm, "$1export ");
}

function compileDeclarations(file: string): void {
  execFileSync(
    "npx",
    [
      "tsc",
      "--ignoreConfig",
      "--noEmit",
      "--strict",
      "--module",
      "ESNext",
      "--moduleResolution",
      "Bundler",
      "--target",
      "ES2022",
      "--lib",
      "ES2022,DOM,DOM.Iterable",
      "--jsx",
      "react-jsx",
      "--types",
      "vite/client,node",
      "--skipLibCheck",
      "false",
      file,
    ],
    { cwd: root, stdio: "inherit" },
  );
}

const output = `// Generated by npm run api:generate. Do not edit.\n${files
  .map(
    ({ file, module }) =>
      `declare module "${module}" {\n${ambient(rewriteImports(readFileSync(file, "utf8"), file))
        .trim()
        .split("\n")
        .map((line) => (line ? `  ${line}` : line))
        .join("\n")}\n}`,
  )
  .join("\n\n")}\n`;
const target = join(root, "engines/design_system/api.d.ts");

if (process.argv.includes("--check")) {
  let current = "";
  try {
    current = readFileSync(target, "utf8");
  } catch {
    current = "";
  }
  // Compile before the byte comparison so a syntactically broken declaration
  // file fails for that reason, not as "stale" (the canary relies on it).
  if (current !== "") {
    compileDeclarations(target);
  }
  if (current !== output) {
    console.error("design_system api.d.ts is stale; run npm run api:generate");
    process.exit(1);
  }
  console.log(`design_system api: checked ${modules.size} module(s)`);
} else {
  writeFileSync(target, output);
  compileDeclarations(target);
  console.log(`design_system api: generated ${modules.size} module(s)`);
}
