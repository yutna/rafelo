import { readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const root = process.cwd();
const source = readFileSync(join(root, "engines/design_system/app/frontend/public/index.ts"), "utf8");
const lines = source
  .split("\n")
  .filter((line) => line.startsWith("export {"))
  .map((line) => line.replace(/\s+/g, " ").trim())
  .sort();
const output = `// Generated by npm run api:generate. Do not edit.\n${lines.join("\n")}\n`;
const target = join(root, "engines/design_system/api.d.ts");

if (process.argv.includes("--check")) {
  let current = "";
  try {
    current = readFileSync(target, "utf8");
  } catch {
    current = "";
  }
  if (current !== output) {
    console.error("design_system api.d.ts is stale; run npm run api:generate");
    process.exit(1);
  }
  console.log(`design_system api: checked ${lines.length} export line(s)`);
} else {
  writeFileSync(target, output);
  console.log(`design_system api: generated ${lines.length} export line(s)`);
}
