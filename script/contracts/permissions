#!/usr/bin/env ruby
# frozen_string_literal: true

require "yaml"
require "fileutils"
require "optparse"

root = Dir.pwd
check = false
OptionParser.new do |parser|
  parser.banner = "Usage: script/contracts/permissions [--root DIR] [--check]"
  parser.on("--root DIR") { |value| root = value }
  parser.on("--check") { check = true }
end.parse!
root = File.expand_path(root)
errors = []

Dir[File.join(root, "engines/*/config/permissions.yml")].sort.each do |path|
  engine = File.basename(File.dirname(File.dirname(path)))
  engine_camel = engine.camelize
  manifest = YAML.load_file(path)
  ruby = +"# frozen_string_literal: true\n\nmodule Rafelo\n  module #{engine_camel}\n    module Permissions\n"
  ts = +"// Generated by npm run permissions:generate. Do not edit.\n\nexport const Permissions = {\n"
  manifest.each do |prefix, resources|
    next unless resources.is_a?(Hash)

    resources.each do |resource, actions|
      Array(actions).each do |action|
        key = "#{prefix}:#{resource}:#{action}"
        constant = "#{resource}_#{action}".upcase
        ruby << "      #{constant} = \"#{key}\"\n"
        ts << "  #{constant}: \"#{key}\",\n"
      end
    end
  end
  ruby << "    end\n  end\nend\n"
  ts << "} as const;\n"

  ruby_path = File.join(root, "engines", engine, "app/public/rafelo/#{engine}/permissions.rb")
  ts_path = File.join(root, "engines", engine, "app/frontend/permissions.generated.ts")
  { ruby_path => ruby, ts_path => ts }.each do |target, content|
    if check
      errors << "#{target.delete_prefix("#{root}/")} is stale" unless File.file?(target) && File.read(target) == content
    else
      FileUtils.mkdir_p(File.dirname(target))
      File.write(target, content)
    end
  end
end

if check
  errors.each { |error| warn "permissions: #{error}" }
  exit(errors.empty? ? 0 : 1)
end
puts "permissions: generated #{Dir[File.join(root, "engines/*/config/permissions.yml")].length} manifest(s)"
